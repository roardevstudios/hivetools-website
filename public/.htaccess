DirectoryIndex index.html
Options -Indexes
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Canonical host (no www): login sessions live in the browser per-host,
# so www vs non-www flips looked like being "signed out"
RewriteCond %{HTTP_HOST} ^www\.hivetools\.pro$ [NC]
RewriteRule ^ https://hivetools.pro%{REQUEST_URI} [L,R=301]

# Redirect browser URLs with .html extension to clean URLs (e.g. /download.html -> /download)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Explicit clean routes
RewriteRule ^admin/?$ admin.html [L]
RewriteRule ^download/?$ download.html [L]
RewriteRule ^docs/?$ docs.html [L]
RewriteRule ^use-cases/?$ use-cases.html [L]
RewriteRule ^pricing/?$ pricing.html [L]
RewriteRule ^auth/?$ auth.html [L]
RewriteRule ^profile/?$ profile.html [L]
RewriteRule ^changelog/?$ changelog.html [L]
RewriteRule ^benchmarks/?$ benchmarks.html [L]
RewriteRule ^index/?$ index.html [L]

# Fallback for any other extensionless requests matching an .html file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# Catch-all non-existent paths -> 404.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^.*$ 404.html [L]

<IfModule mod_mime.c>
  AddType application/octet-stream .exe
</IfModule>

<IfModule mod_headers.c>
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # HTML and the shared stylesheet/script must revalidate on every load.
  # The host's default static cache is 7 days, which let browsers pair a new
  # index.html with an old hive-ui.css and render whole sections unstyled.
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
