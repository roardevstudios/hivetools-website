---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { DISCORD } from '../lib/site';
import Waitlist from '../components/Waitlist.astro';

const plans = [
  { name: 'Hive Starter', tag: 'Monthly plan', price: '€4.99', per: '/ month', note: 'Planned monthly subscription · checkout not open yet',
    d: 'The essentials for everyday AI work.',
    f: ['Hive desktop workspace', '50,000 AI tokens / day', '5 voice sessions / day', 'Research and agent tools', 'PC actions require your approval'],
    plan: 'hive_starter' as const },
  { name: 'Hive Plus', tag: 'Most popular', price: '€12.99', per: '/ month', note: 'Planned monthly subscription · checkout not open yet', featured: true,
    d: 'More room for research, voice, and daily projects.',
    f: ['Everything in Starter', '500,000 AI tokens / day', '100 voice sessions / day', 'Priority agent swarm routing', 'HiveBox cloud disk & background tasks'],
    plan: 'hive_plus' as const },
  { name: 'Hive Max', tag: 'Monthly plan', price: '€22.99', per: '/ month', note: 'Planned monthly subscription · checkout not open yet',
    d: 'Maximum capacity for demanding workflows.',
    f: ['Everything in Plus', '2,000,000 AI tokens / day', 'Unlimited voice sessions', 'Fastest models + priority swarm', 'HiveBox cloud tasks'],
    plan: 'hive_max' as const },
];
const compare = [
  ['App access (Windows 10/11)', 'Included', 'Included', 'Included'],
  ['Tokens per day', '50K', '500K', '2M'],
  ['Voice sessions per day', '5', '100', 'Unlimited'],
  ['Research, swarm, buddy, notch', 'Included', 'Priority', 'Priority+'],
  ['HiveBox cloud', '—', 'Included', 'Included'],
  ['Billing', 'Monthly subscription', 'Monthly subscription', 'Monthly subscription'],
];
const included = [
  ['Cited Research', 'Ask anything and get answers with live, verified sources: domain, title, snippet and links you can click through yourself.'],
  ['Real PC Control', 'Hive can open apps, run safe shell commands, click and type, always through the Allow/Deny safety prompt.'],
  ['Buddy Notch', 'Ask Buddy anywhere with Ctrl+Shift+J. The notch pops on your desktop even when Hive is minimized.'],
  ['Voice In & Out', 'Dictate commands and hear responses spoken from the Hive desktop app.'],
  ['Agent Swarm', 'Scout, Hive and Pulse work together on one message. Sentry guards tool calls for safety and accuracy.'],
  ['HiveBox Cloud', 'Your own disk for Hive. Store files, run scripts, track concurrent jobs. Toggle the panel anytime.'],
];
const faq = [
  ['How do I get access to Hive?', 'Hive v0.0.1 is in preparation. Follow the changelog or join the community for launch news.'],
  ['Can I download v0.0.1 yet?', 'Not yet. The first public release is coming soon, and the installer will be posted here when it is ready.'],
  ['Are these one-time unlocks?', 'No. Hive has three monthly subscription plans: Starter at €4.99, Plus at €12.99, and Max at €22.99. There are no one-time unlock plans.'],
  ['When will v0.0.1 be available?', 'The release date has not been announced yet. We will post it on the changelog.'],
];
---
<Base title="Hive — plans and pricing" description="Choose a Hive monthly subscription: Starter €4.99, Plus €12.99, or Max €22.99 per month.">
  <PageHero eyebrow="Plans and pricing" title='One Hive subscription. <span class="text-gradient">Three ways to work.</span>' lead="Choose a monthly plan for your Hive workspace. Every tier includes the desktop app, with higher daily AI and voice limits as you move up.">
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a class="btn btn-primary" href="#plans">Choose your plan</a>
      <a class="btn btn-ghost" href={DISCORD} target="_blank" rel="noopener noreferrer">Join the community</a>
    </div>
  </PageHero>

  <section id="plans" class="wrap">
    <div class="grid gap-4 lg:grid-cols-3">
      {plans.map((p, i) => (
        <article data-reveal style={`--i:${i}`} class:list={['glass relative flex flex-col p-7', p.featured && 'border-honey/50 lg:-translate-y-3', p.retired && 'opacity-80']}>
          {p.featured && <div aria-hidden="true" class="absolute inset-x-8 -top-px h-px bg-gradient-to-r from-transparent via-honey to-transparent"></div>}
          <span class:list={['w-fit rounded-full px-2.5 py-0.5 text-xs', p.retired ? 'border border-line text-dim' : 'border border-honey/30 bg-honey/10 text-honey-2']}>{p.tag}</span>
          <h2 class="mt-4 text-2xl font-semibold">{p.name}</h2>
          <p class="mt-2 text-sm text-dim">{p.d}</p>
          <p class="mt-6"><span class:list={['font-display text-4xl font-bold text-text', p.retired && 'line-through decoration-honey/60']}>{p.price}</span> <span class="text-dim">{p.per}</span></p>
          <p class="mt-1 text-xs text-dim">{p.note}</p>
          <ul class="mt-6 flex-1 space-y-2.5 text-sm">
            {p.f.map((f) => <li class="flex gap-2.5"><span class="text-honey">✓</span><span>{f}</span></li>)}
          </ul>
          {p.cta && <a href={p.cta[1]} class="btn btn-ghost mt-8 w-full">{p.cta[0]}</a>}
          {p.plan && <div class="mt-8"><Waitlist plan={p.plan} source={p.plan} cta="Notify me" compact /></div>}
          {!p.retired && <p class="mt-3 text-center text-xs text-dim">Planned monthly subscription · EUR incl. VAT · no checkout yet</p>}
        </article>
      ))}
    </div>
  </section>

  <section class="wrap py-20">
    <h2 class="h-section mb-8" data-reveal>Compare plans</h2>
    <div class="overflow-x-auto rounded-3xl border border-line" data-reveal>
      <table class="w-full min-w-[640px] text-left text-sm">
        <thead class="bg-panel-2 text-text"><tr><th class="p-4 font-medium">Compare</th><th class="p-4 font-medium">Hive Starter <span class="text-dim">€4.99/mo</span></th><th class="p-4 font-medium">Hive Plus <span class="text-dim">€12.99/mo</span></th><th class="p-4 font-medium">Hive Max <span class="text-dim">€22.99/mo</span></th></tr></thead>
        <tbody>{compare.map((r) => <tr class="border-t border-line">{r.map((c, i) => <td class:list={['p-4', i === 0 ? 'text-text' : 'text-dim']}>{c}</td>)}</tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="wrap">
    <h2 class="h-section" data-reveal>What's included at launch</h2>
    <p class="lead mt-4" data-reveal>Every plan includes these core features from day one.</p>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {included.map(([t, d], i) => <div class="glass p-6" data-reveal style={`--i:${i % 3}`}><h3 class="text-lg font-semibold">{t}</h3><p class="mt-2 text-sm text-dim">{d}</p></div>)}
    </div>
  </section>

  <section class="wrap py-20">
    <h2 class="h-section mb-8" data-reveal>Questions</h2>
    <div class="divide-y divide-line rounded-3xl border border-line bg-panel/50">
      {faq.map(([q, a]) => (
        <details class="group px-6" data-reveal>
          <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 py-4 font-medium text-text [&::-webkit-details-marker]:hidden">{q}<span class="grid size-8 shrink-0 place-items-center rounded-full border border-line text-honey-2 transition group-open:rotate-45">+</span></summary>
          <p class="pb-5 text-dim">{a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>
