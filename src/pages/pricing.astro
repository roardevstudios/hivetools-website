---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Waitlist from '../components/Waitlist.astro';
import { planCatalog, type PlanId } from '../lib/plans';

const price = (value: number) => `€${value.toFixed(2)}`;
const planIds = planCatalog.plans.map((plan) => plan.id as PlanId);
---
<Base title="Hive — plans and pricing" description="Hive Free and three planned monthly plans, from €4.99 to €22.99. Checkout is not open yet.">
  <PageHero eyebrow="Plans and pricing" title='Hive plans, <span class="text-gradient">clearly compared.</span>' lead="Four planned tiers: Hive Free, Starter, Plus, and Max. Features and prices may change before release.">
    <div class="mt-8 flex flex-col gap-3 sm:flex-row"><a class="btn btn-primary" href="#plans">Compare plans</a><a class="btn btn-ghost" href="#notify">Get release email</a></div>
  </PageHero>

  <section id="plans" class="wrap">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {planCatalog.plans.map((plan, index) => <article data-reveal style={`--i:${index}`} class:list={['glass relative flex flex-col p-7', plan.id === 'plus' && 'border-honey/50 lg:-translate-y-3']}>
        {plan.id === 'plus' && <div aria-hidden="true" class="absolute inset-x-8 -top-px h-px bg-gradient-to-r from-transparent via-honey to-transparent"></div>}
        <span class="w-fit rounded-full border border-honey/30 bg-honey/10 px-2.5 py-0.5 text-xs text-honey-2">{plan.id === 'free' ? 'Free plan' : 'Monthly plan'}</span>
        <h2 class="mt-4 text-2xl font-semibold">{plan.name}</h2><p class="mt-2 text-sm text-dim">{plan.description}</p>
        <p class="mt-6"><span class="font-display text-4xl font-bold text-text">{price(plan.price)}</span> <span class="text-dim">{plan.period}</span></p>
        <ul class="mt-6 flex-1 space-y-2.5 text-sm">{planCatalog.features.filter((feature) => planIds.indexOf(plan.id as PlanId) >= planIds.indexOf((feature.from ?? 'free') as PlanId)).map((feature) => <li class="flex gap-2.5"><span class="text-honey">✓</span><span>{feature.values[planIds.indexOf(plan.id as PlanId)]} · {feature.label}</span></li>)}</ul>
        {plan.id === 'free' ? <p class="mt-8 text-center text-xs text-dim">No subscription · no checkout required</p> : <p class="mt-8 text-center text-sm text-soft">Checkout is not open yet.</p>}
      </article>)}
    </div>
    <p class="mt-5 text-center text-xs leading-relaxed text-dim">All prices are shown in EUR. VAT treatment and trader details will be confirmed before checkout opens. <!-- TODO: add the legal trader name and postal address and confirm VAT wording before checkout opens. --></p>
  </section>

  <section class="wrap py-20">
    <h2 class="h-section mb-8" data-reveal>Compare plans</h2>
    <div class="overflow-x-auto rounded-3xl border border-line" data-reveal><table class="w-full min-w-[760px] text-left text-sm">
      <thead class="bg-panel-2 text-text"><tr><th class="p-4 font-medium">Feature</th>{planCatalog.plans.map((plan) => <th class="p-4 font-medium">{plan.name}<span class="block text-dim">{plan.price ? `${price(plan.price)}/mo` : price(plan.price)}</span></th>)}</tr></thead>
      <tbody>{planCatalog.features.map((feature) => <tr class="border-t border-line"><th scope="row" class="p-4 font-medium text-text">{feature.label}</th>{feature.values.map((value) => <td class="p-4 text-dim">{value}</td>)}</tr>)}
      <tr class="border-t border-line"><th scope="row" class="p-4 font-medium text-text">Billing</th><td class="p-4 text-dim">Free</td><td class="p-4 text-dim">Monthly</td><td class="p-4 text-dim">Monthly</td><td class="p-4 text-dim">Monthly</td></tr></tbody>
    </table></div>
  </section>

  <section id="notify" class="wrap pb-20"><div class="glass p-8 sm:p-12" data-reveal><h2 class="h-section text-center">Get the v0.0.1 release email.</h2><p class="lead mx-auto mt-4 max-w-2xl text-center">We’ll let you know when release information is posted. Follow the build on Discord or X.</p><div class="mx-auto mt-7 flex justify-center"><Waitlist source="pricing-notify" cta="Email me when v0.0.1 is ready" compact /></div></div></section>
</Base>
