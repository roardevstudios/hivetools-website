---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { planCatalog, planIndex, DISCORD_URL, type PlanId } from '../lib/plans';

const price = (value: number) => `€${value.toFixed(2)}`;

// Each plan gets its own accent so the cards read as separate tiers.
const accent: Record<PlanId, string> = {
  free: '#94a3b8',
  starter: '#38bdf8',
  student: '#34d399',
  max: '#F5B63B',
};
const tagline: Record<PlanId, string> = {
  free: 'Start here',
  starter: 'For daily work',
  student: 'For students',
  max: 'Most capacity',
};
const includedFeatures = (planId: PlanId) =>
  planCatalog.features.filter((feature) => planIndex(planId) >= planIndex((feature.from ?? 'free') as PlanId));
---
<Base title="Hive — plans and pricing" description="Hive Free, Starter, Student and Max. Planned monthly plans from €2.49 to €22.99. Checkout is not open yet.">
  <PageHero eyebrow="Plans and pricing" title='Hive plans, <span class="text-gradient">clearly compared.</span>' lead="Four planned tiers: Free, Starter, Student and Max. Features and prices may change before release.">
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row"><a class="btn btn-primary" href="#plans">Compare plans</a><a class="btn btn-ghost" href="https://discord.com/channels/1545887872391839896/1552691183182938162" target="_blank" rel="noopener noreferrer">Get early access</a></div>
  </PageHero>

  <section id="plans" class="wrap">
    <div class="mx-auto grid max-w-6xl items-stretch gap-5 md:grid-cols-2 xl:grid-cols-4">
      {planCatalog.plans.map((plan, index) => {
        const id = plan.id as PlanId;
        const isMax = id === 'max';
        return (
          <article
            data-reveal
            style={`--i:${index};--accent:${accent[id]};border-color:color-mix(in srgb, ${accent[id]} ${isMax ? '60%' : '28%'}, transparent);${isMax ? 'box-shadow:0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent), 0 24px 60px -24px var(--accent);' : ''}`}
            class:list={['glass relative flex flex-col rounded-3xl border p-7', isMax && 'xl:-translate-y-4']}
          >
            <div class="flex items-center justify-between gap-3">
              <span class="rounded-full px-2.5 py-0.5 text-xs font-medium" style={`background:color-mix(in srgb, ${accent[id]} 14%, transparent);color:${accent[id]}`}>{tagline[id]}</span>
              {isMax && <span class="rounded-full bg-honey px-2.5 py-0.5 text-xs font-semibold text-black">Best value</span>}
            </div>
            <h2 class="mt-5 text-2xl font-semibold">{plan.name}</h2>
            <p class="mt-2 min-h-[2.5rem] text-sm text-dim">{plan.description}</p>
            <p class="mt-5"><span class="font-display text-4xl font-bold" style={`color:${accent[id]}`}>{price(plan.price)}</span> <span class="text-dim">{plan.period || 'forever'}</span></p>

            <ul class="mt-6 flex-1 space-y-2.5 text-sm">
              {includedFeatures(id).map((feature) => (
                <li class="flex gap-2.5">
                  <span class="mt-0.5 shrink-0" style={`color:${accent[id]}`}><Icon name="check" size={16} /></span>
                  <span class={feature.values[planIndex(id)] === '—' ? 'text-dim line-through decoration-white/20' : ''}>{feature.values[planIndex(id)] === '—' ? feature.label : `${feature.values[planIndex(id)]} · ${feature.label}`}</span>
                </li>
              ))}
            </ul>

            {id === 'student' && (
              <div class="mt-6 rounded-2xl border p-4 text-sm leading-relaxed text-soft" style={`border-color:color-mix(in srgb, ${accent[id]} 30%, transparent);background:color-mix(in srgb, ${accent[id]} 6%, transparent)`}>
                <p class="font-medium text-text">How to get Student</p>
                <ol class="mt-2 list-decimal space-y-1 pl-5">
                  <li>Sign up and use your school email.</li>
                  <li>Contact support on our <a class="underline" href={DISCORD_URL} target="_blank" rel="noopener">Discord server</a> with your school email.</li>
                  <li>Support confirms your student status and activates the plan.</li>
                </ol>
              </div>
            )}

            <p class="mt-7 text-center text-xs text-dim">
              {id === 'free' ? 'No subscription · no checkout required' : 'Checkout is not open yet.'}
            </p>
          </article>
        );
      })}
    </div>
    <p class="mx-auto mt-6 max-w-3xl text-center text-xs leading-relaxed text-dim">All prices are shown in EUR. VAT treatment and trader details will be confirmed before checkout opens. <!-- TODO: add the legal trader name and postal address and confirm VAT wording before checkout opens. --></p>
  </section>

  <section class="wrap py-20">
    <div class="mx-auto max-w-6xl">
      <h2 class="h-section mb-8 text-center" data-reveal>Compare plans</h2>
      <div class="overflow-x-auto rounded-3xl border border-line" data-reveal>
        <table class="w-full min-w-[820px] text-left text-sm">
          <thead class="bg-panel-2 text-text">
            <tr>
              <th class="p-4 font-medium">Feature</th>
              {planCatalog.plans.map((plan) => (
                <th class="p-4 font-medium" style={`color:${accent[plan.id as PlanId]}`}>{plan.name}<span class="block text-xs font-normal text-dim">{plan.price ? `${price(plan.price)}/mo` : price(plan.price)}</span></th>
              ))}
            </tr>
          </thead>
          <tbody>
            {planCatalog.features.map((feature) => (
              <tr class="border-t border-line">
                <th scope="row" class="p-4 font-medium text-text">{feature.label}</th>
                {feature.values.map((value) => <td class="p-4 text-dim">{value}</td>)}
              </tr>
            ))}
            <tr class="border-t border-line">
              <th scope="row" class="p-4 font-medium text-text">Billing</th>
              <td class="p-4 text-dim">Free</td>
              <td class="p-4 text-dim">Monthly</td>
              <td class="p-4 text-dim">Monthly</td>
              <td class="p-4 text-dim">Monthly</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

</Base>
