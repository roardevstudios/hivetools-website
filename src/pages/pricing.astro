---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { planCatalog, planIndex, DISCORD_URL, type PlanId } from '../lib/plans';

const price = (value: number) => `€${value.toFixed(2)}`;

// Each plan gets its own accent so the cards read as separate tiers.
const accent: Record<PlanId, string> = {
  free: '#f4f1ea',
  pro: '#f4f1ea',
  max: '#e7b15a',
};
const tagline: Record<PlanId, string> = {
  free: 'Start here',
  pro: 'For daily work',
  max: 'Most capacity',
};
const includedFeatures = (planId: PlanId) =>
  planCatalog.features.filter((feature) => planIndex(planId) >= planIndex((feature.from ?? 'free') as PlanId));
---
<Base title="Hive — plans and pricing" description="Hive Free, Pro and Max. Monthly plans from €4.99 to €22.99. Checkout is not open yet.">
  <PageHero eyebrow="Plans and pricing" title="Hive plans, clearly compared." lead="Hive Free is €0. Pro is €4.99 a month. Max is €22.99 a month. The Windows installer includes Hive Free. Checkout is closed.">
    <div class="mt-8 flex flex-col gap-3 sm:flex-row"><a class="btn btn-primary" href="#plans">Compare plans</a><a class="btn btn-ghost" href="/download">Download for Windows</a></div>
  </PageHero>

  <section id="plans" class="wrap">
    <p class="mb-8 max-w-3xl border border-line bg-panel px-5 py-4 text-sm leading-relaxed text-soft">Hive Free includes cited research, PC actions, agent tools, and swarm. Limits are 25,000 chat tokens and 5 voice sessions a day. Pro is 50,000 tokens and 25 voice sessions. Max is 2,000,000 tokens and unlimited voice. Buddy, HiveBox, and priority support are on Max and are not in Hive-Setup-v0.0.1.1. Checkout is closed.</p>
    <div class="mx-auto grid max-w-6xl items-stretch gap-5 lg:grid-cols-3">
      {planCatalog.plans.map((plan, index) => {
        const id = plan.id as PlanId;
        const isMax = id === 'max';
        return (
          <article
            data-reveal
            style={`--i:${index};--accent:${accent[id]};border-color:color-mix(in srgb, ${accent[id]} ${isMax ? '48%' : '24%'}, transparent);`}
            class:list={['glass relative flex flex-col border p-7']}
          >
            <div class="flex items-center justify-between gap-3">
              <span class="font-mono text-[.68rem] uppercase tracking-[.14em]" style={`color:${accent[id]}`}>{tagline[id]}</span>
              {isMax && <span class="font-mono text-[.68rem] uppercase tracking-[.14em] text-honey">Highest tier</span>}
            </div>
            <h2 class="mt-5 text-2xl font-semibold">{plan.name}</h2>
            <p class="mt-2 min-h-[2.5rem] text-sm text-dim">{plan.description}</p>
            <p class="mt-5"><span class="font-display text-4xl font-bold" style={`color:${accent[id]}`}>{price(plan.price)}</span> <span class="text-dim">{plan.period || 'forever'}</span></p>

            <ul class="mt-6 flex-1 space-y-2.5 text-sm">
              {includedFeatures(id).map((feature) => (
                <li class="flex gap-2.5">
                  <span class="mt-0.5 shrink-0" style={`color:${accent[id]}`}><Icon name="check" size={16} /></span>
                  <span class={feature.values[planIndex(id)] === '—' ? 'text-dim line-through decoration-white/20' : ''}>{feature.values[planIndex(id)] === '—' ? feature.label : `${feature.values[planIndex(id)]} · ${feature.label}`}</span>
                </li>
              ))}
            </ul>

            
            <p class="mt-7 text-center text-xs text-dim">
              {id === 'free' ? 'No subscription · no checkout required' : 'Checkout is not open yet.'}
            </p>
          </article>
        );
      })}
    </div>
    <p class="mx-auto mt-6 max-w-3xl text-center text-xs leading-relaxed text-dim">All prices are shown in EUR. VAT treatment and trader details will be confirmed before checkout opens. <!-- TODO: add the legal trader name and postal address and confirm VAT wording before checkout opens. --></p>
  </section>

  <section class="wrap py-20">
    <div class="mx-auto max-w-6xl">
      <h2 class="h-section mb-8 text-center" data-reveal>Compare plans</h2>
      <div class="overflow-x-auto border border-line" data-reveal>
        <table class="w-full min-w-[820px] text-left text-sm">
          <thead class="bg-panel-2 text-text">
            <tr>
              <th class="p-4 font-medium">Feature</th>
              {planCatalog.plans.map((plan) => (
                <th class="p-4 font-medium" style={`color:${accent[plan.id as PlanId]}`}>{plan.name}<span class="block text-xs font-normal text-dim">{plan.price ? `${price(plan.price)}/mo` : price(plan.price)}</span></th>
              ))}
            </tr>
          </thead>
          <tbody>
            {planCatalog.features.map((feature) => (
              <tr class="border-t border-line">
                <th scope="row" class="p-4 font-medium text-text">{feature.label}</th>
                {feature.values.map((value) => <td class="p-4 text-dim">{value}</td>)}
              </tr>
            ))}
            <tr class="border-t border-line">
              <th scope="row" class="p-4 font-medium text-text">Billing</th>
              <td class="p-4 text-dim">Free</td>
              <td class="p-4 text-dim">Monthly</td>
              <td class="p-4 text-dim">Monthly</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

</Base>
