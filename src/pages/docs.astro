---
import Base from '../layouts/Base.astro';
import DocsSection from '../components/DocsSection.astro';
import { docGroups } from '../content/docs';

const sections = docGroups.flatMap((group) => group.items);
const related = (section: (typeof sections)[number]) => {
  const index = sections.indexOf(section);
  return { previous: sections[index - 1], next: sections[index + 1] };
};
---
<Base title="Hive Docs — overview" description="Planned Hive app workflows, plan availability, account help, and release status.">
  <div class="wrap docs-page">
    <header class="docs-intro">
      <span class="eyebrow">Documentation</span>
      <h1>Hive documentation</h1>
      <p>Hive v0.0.1 is not ready to download. This guide describes planned app workflows and their plan availability; the website does not run them.</p>
    </header>

    <div class="docs-mobile-bar" id="docs-mobile-bar">
      <span id="docs-current-section" aria-live="polite">Overview</span>
      <button id="docs-mobile-open" type="button" aria-haspopup="dialog" aria-controls="docs-mobile-dialog">Browse sections</button>
    </div>

    <dialog class="docs-mobile-dialog" id="docs-mobile-dialog" aria-labelledby="docs-mobile-title">
      <div class="docs-dialog-head">
        <h2 id="docs-mobile-title">Browse docs</h2>
        <button id="docs-mobile-close" type="button">Close</button>
      </div>
      <label class="sr-only" for="docs-mobile-search">Search docs</label>
      <input id="docs-mobile-search" class="docs-search" type="search" placeholder="Search docs" autocomplete="off" />
      <p class="docs-search-status" id="docs-mobile-status" role="status" aria-live="polite"></p>
      <nav id="docs-mobile-nav" class="docs-nav" aria-label="Mobile documentation sections">
        {docGroups.map((group) => <div class="docs-nav-group" data-nav-group>
          <h3>{group.title}</h3>
          <ul>{group.items.map((section) => <li><a href={`#${section.id}`} data-doc-link={section.id}>{section.title}</a></li>)}</ul>
        </div>)}
      </nav>
    </dialog>

    <div class="docs-layout">
      <aside class="docs-sidebar" aria-label="Documentation sidebar">
        <label class="sr-only" for="docs-search">Search docs</label>
        <input id="docs-search" class="docs-search" type="search" placeholder="Search docs" autocomplete="off" />
        <p class="docs-search-status" id="docs-search-status" role="status" aria-live="polite"></p>
        <nav id="docs-desktop-nav" class="docs-nav" aria-label="Documentation sections">
          {docGroups.map((group) => <div class="docs-nav-group" data-nav-group>
            <h3>{group.title}</h3>
            <ul>{group.items.map((section) => <li><a href={`#${section.id}`} data-doc-link={section.id}>{section.title}</a></li>)}</ul>
          </div>)}
        </nav>
      </aside>

      <article class="docs-article" id="docs-article">
        <p class="docs-installer-callout">No installer is posted. This guide describes the planned Windows app.</p>
        {docGroups.filter((group) => group.title !== 'Legal').map((group) => group.items.map((section) => {
          const { previous, next } = related(section);
          return <DocsSection section={section} previous={previous} next={next} />;
        }))}
        <div class="docs-legal-group">
          <p class="docs-legal-label">Legal</p>
          {docGroups.find((group) => group.title === 'Legal')?.items.map((section) => {
            const { previous, next } = related(section);
            return <DocsSection section={section} previous={previous} next={next} />;
          })}
        </div>
      </article>

      <aside class="docs-on-page" id="docs-on-page" aria-label="On this page" hidden>
        <h2>On this page</h2>
        <nav aria-label="Headings in this section"><ul id="docs-subnav"></ul></nav>
      </aside>
    </div>
  </div>
</Base>

<script>
  const sections = [...document.querySelectorAll<HTMLElement>('[data-doc-section]')];
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-doc-link]')];
  const inputs = [document.getElementById('docs-search'), document.getElementById('docs-mobile-search')] as HTMLInputElement[];
  const statusEls = [document.getElementById('docs-search-status'), document.getElementById('docs-mobile-status')];
  const dialog = document.getElementById('docs-mobile-dialog') as HTMLDialogElement;
  const openButton = document.getElementById('docs-mobile-open') as HTMLButtonElement;
  const article = document.getElementById('docs-article')!;
  const subnav = document.getElementById('docs-subnav')!;
  const onPage = document.getElementById('docs-on-page') as HTMLElement;
  const currentLabel = document.getElementById('docs-current-section')!;

  function buildSubnav(section: HTMLElement) {
    const headings = [...section.querySelectorAll<HTMLElement>('.docs-prose h3')];
    subnav.replaceChildren();
    headings.forEach((heading, index) => {
      if (!heading.id) heading.id = `${section.dataset.docId}-topic-${index + 1}`;
      const item = document.createElement('li');
      const link = document.createElement('a');
      link.href = `#${heading.id}`;
      link.textContent = heading.textContent ?? '';
      item.append(link);
      subnav.append(item);
    });
    onPage.hidden = headings.length === 0;
  }

  function setActive(section: HTMLElement) {
    const id = section.dataset.docId!;
    links.forEach((link) => {
      if (link.dataset.docLink === id) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
    currentLabel.textContent = section.querySelector('h2')?.textContent?.replace('#', '').trim() ?? 'Documentation';
    buildSubnav(section);
  }

  function refreshActive() {
    const threshold = window.scrollY + (window.matchMedia('(min-width: 1024px)').matches ? 140 : 190);
    const available = sections.filter((section) => !section.hidden);
    let active = available[0];
    for (const section of available) {
      if (section.getBoundingClientRect().top + window.scrollY <= threshold) active = section;
      else break;
    }
    if (active) setActive(active);
  }

  function filterDocs(rawQuery: string) {
    const query = rawQuery.trim().toLocaleLowerCase();
    let matches = 0;
    sections.forEach((section) => {
      const title = section.querySelector('h2')?.textContent ?? '';
      const summary = section.querySelector('.docs-summary')?.textContent ?? '';
      const match = !query || `${title} ${summary}`.toLocaleLowerCase().includes(query);
      section.hidden = !match;
      if (match) matches++;
    });
    document.querySelectorAll<HTMLElement>('[data-nav-group]').forEach((group) => {
      const items = [...group.querySelectorAll<HTMLAnchorElement>('[data-doc-link]')];
      items.forEach((link) => { link.closest('li')!.hidden = !!query && sections.find((section) => section.dataset.docId === link.dataset.docLink)?.hidden; });
      group.hidden = !!query && !items.some((link) => !link.closest('li')!.hidden);
    });
    statusEls.forEach((el) => { if (el) el.textContent = query ? `${matches} section${matches === 1 ? '' : 's'} found` : ''; });
    refreshActive();
  }

  inputs.forEach((input) => input.addEventListener('input', () => {
    inputs.forEach((other) => { if (other !== input) other.value = input.value; });
    filterDocs(input.value);
  }));
  inputs.forEach((input) => input.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter') return;
    const query = input.value.trim().toLocaleLowerCase();
    const match = sections.find((section) => !section.hidden && `${section.querySelector('h2')?.textContent ?? ''} ${section.querySelector('.docs-summary')?.textContent ?? ''}`.toLocaleLowerCase().includes(query));
    if (!match || !query) return;
    event.preventDefault();
    const heading = match.querySelector('h2') as HTMLElement;
    history.replaceState(null, '', `#${match.dataset.docId}`);
    heading.focus({ preventScroll: true });
    heading.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    if (dialog.open) dialog.close();
  }));

  openButton.addEventListener('click', () => {
    dialog.showModal();
    document.getElementById('docs-mobile-search')?.focus();
  });
  document.getElementById('docs-mobile-close')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => openButton.focus());
  dialog.querySelectorAll<HTMLAnchorElement>('[data-doc-link]').forEach((link) => link.addEventListener('click', () => dialog.close()));

  article.querySelectorAll<HTMLElement>('.docs-prose h3').forEach((heading, index) => {
    if (!heading.id) heading.id = `docs-topic-${index + 1}`;
    const anchor = document.createElement('a');
    anchor.className = 'docs-heading-link';
    anchor.href = `#${heading.id}`;
    anchor.setAttribute('aria-label', `Link to ${heading.textContent ?? 'heading'}`);
    anchor.textContent = '#';
    heading.prepend(anchor);
  });
  window.addEventListener('scroll', refreshActive, { passive: true });
  window.addEventListener('resize', refreshActive);
  window.addEventListener('hashchange', refreshActive);
  refreshActive();
</script>

<style is:global>
  .docs-page { padding-top: 7.5rem; }
  .docs-intro { max-width: 52rem; margin-bottom: 2.5rem; }
  .docs-intro h1 { margin-top: 1rem; font-size: clamp(2.5rem, 6vw, 4.25rem); line-height: 1.02; font-weight: 750; letter-spacing: -.045em; }
  .docs-intro > p:last-child { margin-top: 1.1rem; max-width: 42rem; color: var(--color-soft); font-size: 1.05rem; line-height: 1.7; }
  .docs-layout { display: grid; gap: 2rem; align-items: start; }
  .docs-article { min-width: 0; max-width: 72ch; }
  .docs-sidebar { display: none; }
  .docs-search { width: 100%; min-height: 2.75rem; padding: .65rem .8rem; border: 1px solid var(--color-line); border-radius: .65rem; background: var(--color-panel); color: var(--color-text); }
  .docs-search::placeholder { color: var(--color-dim); }
  .docs-search:focus-visible, .docs-mobile-bar button:focus-visible, .docs-mobile-dialog button:focus-visible, .docs-nav a:focus-visible, .docs-on-page a:focus-visible { outline: 2px solid var(--color-honey); outline-offset: 3px; }
  .docs-search-status { min-height: 1.25rem; margin: .35rem 0 .5rem; color: var(--color-soft); font-size: .75rem; }
  .docs-nav { display: grid; gap: 1.25rem; }
  .docs-nav-group h3 { margin: 0 0 .4rem; color: var(--color-soft); font-size: .68rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }
  .docs-nav-group ul { margin: 0; padding: 0; list-style: none; border-left: 1px solid var(--color-line); }
  .docs-nav-group li { margin: 0; }
  .docs-nav-group a { display: block; margin-left: -1px; padding: .38rem .65rem .38rem .85rem; border-left: 2px solid transparent; color: var(--color-soft); font-size: .875rem; line-height: 1.35; text-decoration: none; }
  .docs-nav-group a:hover { color: var(--color-text); }
  .docs-nav-group a[aria-current="true"] { border-left-color: var(--color-honey); color: var(--color-text); font-weight: 600; }
  .docs-installer-callout { margin: 0 0 1.5rem; padding: .9rem 1rem; border: 1px solid rgb(240 138 36 / .35); border-radius: .8rem; background: rgb(240 138 36 / .07); color: var(--color-text); font-size: .92rem; line-height: 1.55; }
  .docs-section { padding: 2rem 0 2.25rem; border-bottom: 1px solid var(--color-line); scroll-margin-top: 10rem; }
  .docs-section-head { margin-bottom: 1.25rem; }
  .docs-plan-badge { display: inline-flex; margin-bottom: .75rem; padding: .25rem .6rem; border: 1px solid rgb(240 138 36 / .36); border-radius: 999px; background: rgb(240 138 36 / .08); color: var(--color-honey-2); font-size: .7rem; font-weight: 700; letter-spacing: .04em; }
  .docs-section-head h2 { margin: 0; color: var(--color-text); font-size: clamp(1.65rem, 3vw, 2.15rem); line-height: 1.2; font-weight: 700; letter-spacing: -.025em; }
  .docs-summary { margin: .55rem 0 0; color: var(--color-soft); font-size: .98rem; line-height: 1.6; }
  .docs-prose { color: var(--color-soft); font-size: .96rem; line-height: 1.75; }
  .docs-prose > :first-child { margin-top: 0; }
  .docs-prose > :last-child { margin-bottom: 0; }
  .docs-prose h3 { margin: 1.4rem 0 .45rem; color: var(--color-text); font-size: 1.05rem; line-height: 1.4; font-weight: 650; scroll-margin-top: 10rem; }
  .docs-prose p { margin: .55rem 0 1rem; }
  .docs-prose ul { margin: .6rem 0 1rem; padding-left: 1.35rem; list-style: disc; }
  .docs-prose li { padding-left: .2rem; margin: .32rem 0; }
  .docs-prose a { color: var(--color-honey-2); text-decoration: underline; text-underline-offset: 3px; }
  .docs-prose kbd { display: inline-block; min-width: 1.5rem; margin: 0 .08rem; padding: .12rem .35rem; border: 1px solid var(--color-line); border-bottom-width: 2px; border-radius: .35rem; background: var(--color-panel-2); color: var(--color-text); font: 600 .82em/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; text-align: center; }
  .docs-heading-link { margin-right: .45rem; color: var(--color-honey-2); font-size: .78em; text-decoration: none; opacity: 0; }
  .docs-prose h3:hover .docs-heading-link, .docs-heading-link:focus-visible { opacity: 1; }
  .docs-section-head .docs-heading-link { opacity: 0; }
  .docs-section-head h2:hover .docs-heading-link, .docs-section-head .docs-heading-link:focus-visible { opacity: 1; }
  .docs-table-scroll { max-width: 100%; overflow-x: auto; border: 1px solid var(--color-line); border-radius: .75rem; }
  .docs-prose table { width: 100%; min-width: 34rem; border-collapse: collapse; text-align: left; }
  .docs-prose caption { padding: .7rem .9rem; color: var(--color-soft); font-size: .8rem; text-align: left; }
  .docs-prose th, .docs-prose td { padding: .72rem .85rem; border-top: 1px solid var(--color-line); vertical-align: top; }
  .docs-prose thead th { background: var(--color-panel-2); color: var(--color-text); font-size: .8rem; }
  .docs-prose tbody th { color: var(--color-text); font-weight: 600; white-space: nowrap; }
  .docs-prose tbody tr:hover { background: rgb(255 255 255 / .035); }
  .docs-faq { margin: .55rem 0; padding: .8rem .95rem; border: 1px solid var(--color-line); border-radius: .7rem; background: var(--color-panel); }
  .docs-faq summary { color: var(--color-text); font-weight: 600; cursor: pointer; }
  .docs-faq p { margin: .7rem 0 .1rem; }
  .docs-prev-next { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1.6rem; }
  .docs-prev-next a { display: flex; align-items: center; gap: .7rem; max-width: 48%; color: var(--color-soft); text-decoration: none; }
  .docs-prev-next a:hover { color: var(--color-text); }
  .docs-prev-next a > span[aria-hidden] { color: var(--color-honey-2); font-size: 1.2rem; }
  .docs-prev-next small, .docs-prev-next strong { display: block; }
  .docs-prev-next small { color: var(--color-dim); font-size: .7rem; }
  .docs-prev-next strong { margin-top: .12rem; font-size: .85rem; }
  .docs-next { margin-left: auto; text-align: right; }
  .docs-legal-group { margin-top: 2.5rem; padding: 1rem 1.25rem 0; border: 1px solid var(--color-line); border-radius: 1rem; background: rgb(255 255 255 / .018); }
  .docs-legal-label { color: var(--color-dim); font-size: .68rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  .docs-legal-group .docs-section { padding-top: 1.4rem; }
  .docs-legal-group .docs-plan-badge { display: none; }
  .docs-mobile-bar { position: sticky; top: 4.5rem; z-index: 30; display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin: 0 -1rem 1rem; padding: .65rem 1rem; border-block: 1px solid var(--color-line); background: rgb(10 10 10 / .94); backdrop-filter: blur(14px); }
  .docs-mobile-bar span { overflow: hidden; color: var(--color-text); font-size: .9rem; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
  .docs-mobile-bar button, .docs-mobile-dialog button { padding: .55rem .8rem; border: 1px solid var(--color-line); border-radius: .6rem; background: var(--color-panel); color: var(--color-text); font-size: .8rem; }
  .docs-mobile-dialog { width: min(30rem, calc(100% - 2rem)); max-height: min(85dvh, 48rem); padding: 1rem; border: 1px solid var(--color-line); border-radius: 1rem; background: var(--color-ink); color: var(--color-text); }
  .docs-mobile-dialog::backdrop { background: rgb(0 0 0 / .72); }
  .docs-dialog-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: .8rem; }
  .docs-dialog-head h2 { margin: 0; font-size: 1.15rem; }
  .docs-mobile-dialog .docs-nav { max-height: 55dvh; overflow: auto; }
  .docs-mobile-dialog .docs-nav-group a[aria-current="true"] { background: rgb(240 138 36 / .08); }
  .docs-on-page { display: none; }
  @media (min-width: 1024px) {
    .docs-layout { grid-template-columns: 240px minmax(0, 72ch); gap: 2.5rem; }
    .docs-sidebar { position: sticky; top: 6.5rem; display: block; max-height: calc(100dvh - 7.5rem); overflow: auto; padding-right: .5rem; }
    .docs-mobile-bar, .docs-mobile-dialog { display: none; }
    .docs-page { padding-top: 8.5rem; }
  }
  @media (min-width: 1280px) {
    .docs-layout { grid-template-columns: 240px minmax(0, 72ch) 180px; gap: 2.5rem; }
    .docs-on-page { position: sticky; top: 6.5rem; display: block; padding-top: .25rem; }
    .docs-on-page[hidden] { display: none; }
    .docs-on-page h2 { margin: 0 0 .75rem; color: var(--color-soft); font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    .docs-on-page ul { margin: 0; padding: 0; list-style: none; }
    .docs-on-page li { margin: .4rem 0; }
    .docs-on-page a { color: var(--color-soft); font-size: .78rem; line-height: 1.4; text-decoration: none; }
    .docs-on-page a:hover { color: var(--color-text); }
  }
  @media (prefers-reduced-motion: reduce) { .docs-prose *, .docs-nav a { scroll-behavior: auto !important; transition-duration: .01ms !important; } }
</style>
