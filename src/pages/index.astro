---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import DemoChat from '../components/DemoChat.astro';
import Waitlist from '../components/Waitlist.astro';
import { DISCORD, SUPPORT_EMAIL, X_URL } from '../lib/site';
import { planCatalog, type PlanId } from '../lib/plans';

const chapters = [[0, 'Intro'], [4, 'Meet Hive'], [7.7, 'PC action'], [13.3, 'Cited research'], [18, 'Agent crew'], [23, 'Approvals'], [28.3, 'Voice'], [32.3, 'Code work'], [36.7, 'Night watch'], [40.7, 'Research, create, act'], [44.3, 'Features'], [47.8, 'Hive']] as const;
const levelNames: Record<PlanId, string> = { free: 'Free', starter: 'Starter', plus: 'Plus', max: 'Max' };
const featureCards = planCatalog.features.map((feature) => ({
  title: feature.home,
  plan: levelNames[feature.from ?? 'free'],
  description: feature.id === 'tokens' ? '25,000 chat tokens per day on Hive Free.'
    : feature.id === 'voice' ? `${feature.values[0]} voice sessions per day on Hive Free.`
    : feature.id === 'research' ? 'Cited web research is planned from Starter.'
    : feature.id === 'pc' ? 'PC actions require an Allow or Deny decision; destructive commands are blocked.'
    : feature.id === 'swarm' ? 'Scout, Hive, and Pulse work together. Critic reviews the answer. Sentry watches tool calls.'
    : feature.id === 'buddy' ? 'Buddy and the desktop notch are planned from Plus.'
    : feature.id === 'cloud' ? 'HiveBox cloud disk is planned from Plus.'
    : feature.id === 'background' ? 'HiveBox background tasks are planned for Max.'
    : feature.id === 'models' ? 'Standard models are planned for Free through Plus; Max adds the fastest models and top priority.'
    : feature.id === 'tools' ? 'Standard agent tools are planned from Starter.'
    : 'Core chat workspace is planned across all plans.',
}));
const faq = [
  ['Is Hive available to download?', 'The public beta installer was removed. We’ll explain what changed when v0.0.1 is posted.'],
  ['What does Hive Free include?', 'The planned Free tier includes 25,000 chat tokens per day, 5 voice sessions per day, standard models, and core chat.'],
  ['Are paid plans one-time purchases?', 'No. Starter, Plus, and Max are planned monthly subscriptions. Checkout is not open yet.'],
  ['Where do chats and prompts go?', 'Chats and the Mission Board stay on your device. This website does not run prompts. Model requests are sent to the provider selected in the app.'],
];
---
<Base title="Hive — research, agents, and PC control in one AI workspace">
  <section class="relative overflow-hidden pt-32 pb-20 sm:pt-40">
    <div aria-hidden="true" class="absolute left-1/2 top-0 -z-10 h-[420px] w-[700px] -translate-x-1/2 rounded-full opacity-60 blur-3xl md:h-[620px] md:w-[1100px]" style="background: radial-gradient(closest-side, rgb(240 138 36 / .35), transparent), radial-gradient(closest-side at 80% 40%, rgb(29 155 240 / .12), transparent);"></div>
    <div class="wrap grid items-center gap-12 lg:grid-cols-[1.15fr_.85fr]">
      <div class="text-center lg:text-left">
        <span class="hero-in inline-flex items-center gap-2 rounded-full border border-line bg-panel/70 px-3 py-1.5 text-xs text-soft backdrop-blur"><span class="live-dot"></span> Hive v0.0.1 · release details to come</span>
        <h1 class="mt-6 text-[2.75rem] font-bold leading-[1] sm:text-6xl lg:text-7xl" id="hero-title"><span class="word">Your</span> <span class="word">ideas,</span> <span class="word">meet</span><br class="hidden sm:block" /><span class="word text-gradient">your</span> <span class="word text-gradient">AI</span> <span class="word text-gradient">crew.</span></h1>
        <p class="hero-in lead mx-auto mt-6 max-w-xl lg:mx-0">Cited research, an agent crew, and PC actions that ask first. Those are planned Starter and Plus features. Hive v0.0.1 is not ready to download.</p>
        <ul class="hero-in mt-7 flex flex-wrap justify-center gap-2 lg:justify-start" aria-label="Core capabilities">
          <li class="chip">Cited research</li><li class="chip">Agent crew</li><li class="chip">PC actions with approval</li><li class="chip">Voice</li>
        </ul>
        <div class="hero-in mt-8 flex flex-col items-center lg:items-start"><a class="btn btn-primary" href="#notify">Email me when v0.0.1 is ready</a><div class="mt-4 flex gap-4 text-sm"><a href="#tour" class="text-soft underline-offset-4 hover:text-honey-2 hover:underline">Watch the tour ↓</a><a href={DISCORD} target="_blank" rel="noopener noreferrer" class="text-soft underline-offset-4 hover:text-honey-2 hover:underline">Discord ↗</a><a href={X_URL} target="_blank" rel="noopener noreferrer" class="text-soft underline-offset-4 hover:text-honey-2 hover:underline">X ↗</a></div></div>
      </div>
      <div class="hero-in relative mx-auto w-64 sm:w-80 lg:w-full lg:max-w-sm" aria-hidden="true"><div class="absolute inset-8 rounded-full bg-honey/30 blur-3xl"></div><img src="/hive-buddy-float.webp" alt="" width="330" height="330" class="animate-float relative w-full drop-shadow-[0_30px_60px_rgba(240,138,36,.35)]" fetchpriority="high" /></div>
    </div>
  </section>

  <section id="tour" class="wrap py-24">
    <SectionHead eyebrow="Meet your desktop AI" title="See Hive at work." lead="A quick tour of research, PC control, your AI crew and more." center />
    <div class="glass mx-auto max-w-5xl overflow-hidden p-2 sm:p-3" data-reveal>
      <video id="tour-video" class="aspect-video w-full rounded-2xl bg-black" controls playsinline preload="metadata" poster="/videos/hive-motion-design-poster.jpg" aria-label="Hive motion design film: PC actions, cited research, agent teamwork, approvals, voice, and code"><source src="/videos/hive-motion-design.mp4" type="video/mp4" /></video>
      <div class="flex gap-2 overflow-x-auto p-2 pt-3 [scrollbar-width:none]" role="group" aria-label="Chapters">{chapters.map(([t, label]) => <button type="button" data-t={t} class="shrink-0 rounded-full border border-line px-3.5 py-1.5 text-sm text-dim transition hover:border-honey/50 hover:text-text">{label}</button>)}</div>
    </div>
  </section>

  <section id="demo-section" class="wrap py-16"><div class="grid items-center gap-12 lg:grid-cols-2"><div><SectionHead eyebrow="Scripted preview" title="A little work, handled together." lead="Watch a preview of the app. This demonstration does not submit prompts or control your PC." /></div><DemoChat /></div></section>

  <section id="features" class="wrap py-24">
    <SectionHead eyebrow="Planned plan features" title="One window. Every job." lead="The same plan catalog powers this overview and the pricing comparison. Features are planned and subject to change before checkout opens." />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{featureCards.map((feature, i) => <article data-reveal style={`--i:${i % 3}`} class="card glass lift p-6"><div class="flex items-center justify-between"><span class="eyebrow">{feature.plan}</span><span class="card-index">{String(i + 1).padStart(2, '0')}</span></div><h3 class="mt-4 text-lg font-semibold">{feature.title}</h3><p class="mt-2 text-sm leading-relaxed text-dim">{feature.description}</p></article>)}</div>
  </section>

  <section id="hive-design" class="wrap pb-16"><div class="glass relative overflow-hidden p-8 sm:p-12" data-reveal><div aria-hidden="true" class="absolute -right-16 -top-24 size-64 rounded-full bg-honey/15 blur-3xl"></div><div class="relative max-w-3xl"><span class="eyebrow">Coming to the Hive app</span><h2 class="h-section mt-4">Meet Hive Design.</h2><p class="lead mt-5">A new creative space is on the way. Hive Design is coming to the Hive app.</p></div></div></section>

  <section id="safety" class="wrap py-24"><SectionHead eyebrow="Your PC, your call" title="What we can and can’t promise." lead="Permission, data handling, and who builds Hive." />
    <div class="grid gap-4 md:grid-cols-3">
      <article class="glass p-6"><h3 class="text-lg font-semibold">Permission</h3><p class="mt-2 text-sm leading-relaxed text-dim">Every PC action asks for Allow or Deny. Destructive commands are blocked before they reach the screen. Actions are logged locally.</p></article>
      <article class="glass p-6"><h3 class="text-lg font-semibold">Where data lives</h3><p class="mt-2 text-sm leading-relaxed text-dim">Chats and the Mission Board stay on your device; this site does not run prompts. Account and usage counters are handled by Supabase. Model requests go to the provider selected in the app.</p></article>
      <article class="glass p-6"><h3 class="text-lg font-semibold">Who makes Hive</h3><p class="mt-2 text-sm leading-relaxed text-dim">Apis is an independent studio. Contact <a class="text-honey-2 underline" href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a> or join our <a class="text-honey-2 underline" href={DISCORD} target="_blank" rel="noopener noreferrer">Discord</a>.</p></article>
    </div>
  </section>

  <section id="notify" class="wrap py-16"><div class="glass p-8 sm:p-12" data-reveal><SectionHead eyebrow="Release email" title="Get the v0.0.1 update." lead="We’ll email you when release details are posted." center /><div class="mx-auto mt-7 flex justify-center"><Waitlist source="home-notify" cta="Email me when v0.0.1 is ready" compact /></div></div></section>

  <section id="faq" class="wrap py-16"><SectionHead eyebrow="Good to know" title="Hive, clearly explained." lead="A few quick answers about release status, plans, and data." /><div class="divide-y divide-line rounded-3xl border border-line bg-panel/50">{faq.map(([q, a]) => <details class="faq group px-6" data-reveal><summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 py-4 font-medium text-text">{q}<span class="grid size-8 shrink-0 place-items-center rounded-full border border-line text-honey-2 transition duration-300 group-open:rotate-45">+</span></summary><p class="pb-5 text-dim">{a}</p></details>)}</div></section>

  <section id="team" class="wrap py-24 text-center"><div data-reveal><img src="/logohive.png" alt="" width="345" height="452" loading="lazy" class="mx-auto h-16 w-auto" /><span class="eyebrow mt-6">Who we are</span><h2 class="h-section mt-4">Built by Apis.</h2><p class="lead mx-auto mt-5 max-w-2xl">Apis is an independent studio building Hive. Questions? Email <a class="text-honey-2 underline-offset-4 hover:underline" href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a> or ask in the <a class="text-honey-2 underline-offset-4 hover:underline" href={DISCORD} target="_blank" rel="noopener noreferrer">Discord</a>.</p></div></section>
</Base>

<style>
  .faq summary::-webkit-details-marker { display: none; }
  .faq[open] p { animation: fade .4s var(--ease-spring); }
  @keyframes fade { from { opacity: 0; transform: translateY(-6px); } }
</style>

<script>
  import { animate, stagger } from 'motion';
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    animate('#hero-title .word', { opacity: [0, 1], y: [28, 0] }, { delay: stagger(0.07), duration: 0.8, ease: [0.2, 0.8, 0.2, 1] });
    animate('.hero-in', { opacity: [0, 1], y: [16, 0] }, { delay: stagger(0.08, { startDelay: 0.35 }), duration: 0.7, ease: [0.2, 0.8, 0.2, 1] });
  }
  const video = document.getElementById('tour-video') as HTMLVideoElement | null;
  document.querySelectorAll<HTMLButtonElement>('[data-t]').forEach((button) => button.addEventListener('click', () => { if (!video) return; video.currentTime = Number(button.dataset.t); video.play().catch(() => {}); }));
</script>
