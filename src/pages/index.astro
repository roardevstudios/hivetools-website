---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import DemoChat from '../components/DemoChat.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import { DISCORD, SUPPORT_EMAIL, X_URL } from '../lib/site';
import { planCatalog, type PlanId } from '../lib/plans';

const chapters = [[0, 'Intro'], [4, 'Meet Hive'], [7.7, 'PC action'], [13.3, 'Cited research'], [18, 'Agent crew'], [23, 'Approvals'], [28.3, 'Voice'], [32.3, 'Code work'], [36.7, 'Night watch'], [40.7, 'Research, create, act'], [44.3, 'Features'], [47.8, 'Hive']] as const;
const levelNames: Record<PlanId, string> = { free: 'Free', pro: 'Pro', max: 'Max' };
const featureIcons: Record<string, IconName> = { tokens: 'tokens', voice: 'mic', research: 'research', pc: 'pc', swarm: 'bot', buddy: 'buddy', models: 'spark', tools: 'tools', chat: 'chat' };
const featureCards = [...planCatalog.features.filter((feature) => !['cloud', 'background'].includes(feature.id)).map((feature) => ({
  icon: featureIcons[feature.id] ?? 'spark',
  title: feature.home,
  plan: levelNames[feature.from ?? 'free'],
  description: feature.id === 'tokens' ? '25,000 chat tokens per day on Hive Free.'
    : feature.id === 'voice' ? `${feature.values[0]} voice sessions per day on Hive Free.`
    : feature.id === 'chat' ? 'Core chat is in the Windows installer, Hive-Setup-v0.0.1.1.'
    : feature.id === 'research' ? 'Cited web research is in this installer. It is not a future plan item.'
    : feature.id === 'pc' ? 'PC actions in this installer ask for Allow or Deny. Destructive commands are blocked.'
    : feature.id === 'swarm' ? 'Scout, Hive, and Pulse work together in this installer. Critic reviews the answer. Sentry watches tool calls.'
    : feature.id === 'buddy' ? 'Buddy and the desktop notch are not in this installer.'
    : feature.id === 'models' ? 'The plan catalog lists Qwen on Pro and Nemotron on Max. Paid checkout is closed, so this installer does not unlock those paid models.'
    : feature.id === 'tools' ? 'Standard agent tools are in this installer, together with chat and cited research.'
    : feature.id === 'support' ? 'Priority support is a Max catalog item. Checkout is closed, so it is not part of this installer.'
    : feature.home,
})), {
  icon: 'connectors' as IconName,
  title: 'Connectors for your tools',
  plan: 'Live',
  description: 'Google, Slack, GitHub, and Linear connectors are live.',
}, {
  icon: 'cloud-pc' as IconName,
  title: 'Instabox Cloud PC',
  plan: 'Planned',
  description: 'A future Instabox Cloud PC integration is planned to let Hive work with a remote computer. Scope, access, and availability details will follow.',
}];
const faq = [
  ['Is Hive available to download?', 'Yes. Download the Windows installer from the download page.'],
  ['What does Hive Free include?', 'The installer includes Hive Free: core chat, cited research, and PC actions with Allow or Deny. The plan catalog lists 25,000 chat tokens per day and 5 voice sessions per day. Paid checkout is closed.'],
  ['Are paid plans one-time purchases?', 'No. Pro and Max are monthly subscriptions. Checkout is not open yet.'],
  ['Where do chats and prompts go?', 'Chats stay on your device. This website does not run prompts. Model requests are sent to the provider selected in the app.'],
];
---
<Base title="Hive — research, agents, and PC control in one AI workspace">
  <section class="border-b border-line pt-10 pb-16 sm:pt-14 sm:pb-24">
    <div class="wrap grid items-start gap-14 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,.85fr)] lg:gap-16">
      <div>
        <p class="font-mono text-[.72rem] uppercase tracking-[.16em] text-honey">Windows desktop · Hive-Setup-v0.0.1.1</p>
        <h1 class="mt-5 max-w-[14ch] text-[2.7rem] leading-[.96] sm:text-6xl lg:text-[4.4rem]">It asks before it touches the PC.</h1>
        <p class="lead mt-6 max-w-xl">Hive is a desktop AI for cited research and a crew of agents. PC actions wait for Allow or Deny. The free installer needs no card. Checkout is closed.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a class="btn btn-primary" href="/download">Download for Windows</a>
          <a class="btn btn-ghost" href="/docs">Read the docs</a>
        </div>
        <p class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-dim">
          <a href="#tour" class="underline-offset-4 hover:text-text hover:underline">Watch the tour</a>
          <a href={DISCORD} target="_blank" rel="noopener noreferrer" class="underline-offset-4 hover:text-text hover:underline">Discord</a>
          <a href={X_URL} target="_blank" rel="noopener noreferrer" class="underline-offset-4 hover:text-text hover:underline">X</a>
        </p>
      </div>
      <aside class="border border-line bg-panel" aria-label="Sample Hive workflow. Crew order is Scout, Hive, Pulse, Critic, Sentry. Buddy is not in this installer.">
        <header class="flex items-center justify-between gap-3 border-b border-line px-4 py-3 font-mono text-[.68rem] uppercase tracking-[.14em] text-dim">
          <span>Sample workflow</span>
          <span>Example</span>
        </header>
        <div class="border-b border-line px-4 py-5">
          <p class="font-mono text-[.68rem] uppercase tracking-[.14em] text-dim">You asked</p>
          <p class="mt-2 text-lg leading-snug text-text">Compare these options and show me the sources.</p>
        </div>
        <ol class="crew-order">
          <li><span>01</span><strong>Scout</strong><em>Find sources</em></li>
          <li><span>02</span><strong>Hive</strong><em>Write clearly</em></li>
          <li><span>03</span><strong>Pulse</strong><em>Join the draft</em></li>
          <li><span>04</span><strong>Critic</strong><em>Check claims</em></li>
          <li><span>05</span><strong>Sentry</strong><em>Watch tool calls</em></li>
        </ol>
        <p class="border-t border-line px-4 py-4 text-sm leading-relaxed text-soft">Crew order: Scout, Hive, Pulse, Critic, Sentry. PC actions wait for your approval. Buddy is not in this installer. Checkout is closed.</p>
      </aside>
    </div>
  </section>

  <section id="tour" class="wrap py-24">
    <SectionHead eyebrow="Meet your desktop AI" title="See Hive at work." lead="A quick tour of research, PC control, your AI crew and more." center />
    <div class="glass mx-auto max-w-5xl overflow-hidden p-2 sm:p-3" data-reveal>
      <video id="tour-video" class="aspect-video w-full bg-black" controls playsinline preload="metadata" poster="/videos/hive-motion-design-poster.jpg" aria-label="Hive motion design film: PC actions, cited research, agent teamwork, approvals, voice, and code"><source src="/videos/hive-motion-design.mp4" type="video/mp4" /></video>
      <div class="flex gap-2 overflow-x-auto p-2 pt-3 [scrollbar-width:none]" role="group" aria-label="Chapters">{chapters.map(([t, label]) => <button type="button" data-t={t} class="shrink-0 border border-line px-3.5 py-1.5 text-sm text-dim transition hover:border-honey hover:text-text">{label}</button>)}</div>
    </div>
  </section>

  <section id="demo-section" class="wrap py-16"><div class="grid items-center gap-12 lg:grid-cols-2"><div><SectionHead eyebrow="Scripted preview" title="A little work, handled together." lead="Watch a preview of the app. This demonstration does not submit prompts or control your PC." /></div><DemoChat /></div></section>

  <section id="features" class="wrap py-24">
    <SectionHead eyebrow="What you get" title="What this installer actually includes." lead="Hive-Setup-v0.0.1.1 includes core chat, cited research, agent tools, swarm, and PC actions with Allow or Deny. Buddy, HiveBox, and priority support are on Max and are not in this installer. Checkout is closed." />
    <div class="border-y border-line">
      {featureCards.map((feature, i) => (
        <article data-reveal style={`--i:${i % 6}`} class="grid gap-2 border-b border-line py-5 last:border-b-0 sm:grid-cols-[7rem_minmax(0,16rem)_1fr] sm:items-baseline sm:gap-6">
          <span class="font-mono text-[.72rem] uppercase tracking-[.14em] text-honey">{feature.plan}</span>
          <h3 class="text-lg">{feature.title}</h3>
          <p class="text-sm leading-relaxed text-dim">{feature.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="hive-design" class="wrap pb-8"><div class="border border-line px-6 py-10 sm:px-10" data-reveal><span class="eyebrow">Live in the Hive app</span><h2 class="h-section mt-4">Meet Hive Design.</h2><p class="lead mt-5 max-w-2xl">A creative space for your work. Hive Design is live in the Hive app.</p></div></section>

  <section id="safety" class="wrap py-24">
    <SectionHead eyebrow="Your PC, your call" title="What we can and can’t promise." lead="Permission, data handling, and who builds Hive." />
    <dl class="border-t border-line">
      <div class="grid gap-2 border-b border-line py-6 md:grid-cols-[12rem_1fr] md:gap-10">
        <dt class="font-mono text-[.72rem] uppercase tracking-[.14em] text-honey">Permission</dt>
        <dd class="text-sm leading-relaxed text-soft">Every PC action asks for Allow or Deny. Destructive commands are blocked before they reach the screen. Actions are logged locally.</dd>
      </div>
      <div class="grid gap-2 border-b border-line py-6 md:grid-cols-[12rem_1fr] md:gap-10">
        <dt class="font-mono text-[.72rem] uppercase tracking-[.14em] text-honey">Where data lives</dt>
        <dd class="text-sm leading-relaxed text-soft">Chats stay on your device; this site does not run prompts. Account and usage counters are handled by Supabase. Model requests go to the provider selected in the app.</dd>
      </div>
      <div class="grid gap-2 border-b border-line py-6 md:grid-cols-[12rem_1fr] md:gap-10">
        <dt class="font-mono text-[.72rem] uppercase tracking-[.14em] text-honey">Who makes Hive</dt>
        <dd class="text-sm leading-relaxed text-soft">Apis is an independent studio. Contact <a class="text-honey underline" href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a> or join our <a class="text-honey underline" href={DISCORD} target="_blank" rel="noopener noreferrer">Discord</a>.</dd>
      </div>
    </dl>
  </section>

  <section id="partners" class="wrap py-20 sm:py-28" aria-labelledby="partners-title">
    <div class="grid gap-8 border-t border-line pt-9 sm:pt-12 lg:grid-cols-[.8fr_1.2fr] lg:items-center lg:gap-16" data-reveal>
      <div class="max-w-lg">
        <span class="eyebrow">Partners &amp; sponsors</span>
        <h2 id="partners-title" class="h-section mt-4">Good company.<br class="hidden sm:block" /> Better work.</h2>
        <p class="lead mt-5">Meet the products and teams we’re glad to work alongside.</p>
      </div>
      <article class="lift grid gap-6 rounded-sm border border-line bg-panel p-5 transition sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:gap-8 sm:p-7">
        <div class="flex min-w-0 items-center gap-5 sm:gap-7">
          <div class="grid size-24 shrink-0 place-items-center rounded-sm border border-white/10 bg-[#11190f] p-3 sm:size-28 sm:p-4">
            <img src="/partners/mori-logo.png" alt="Mori" width="260" height="80" loading="lazy" class="h-auto w-full object-contain" />
          </div>
          <div class="min-w-0">
            <span class="eyebrow text-[.65rem] tracking-[.12em]">Product partner</span>
            <h3 class="mt-2 text-2xl font-normal tracking-tight">Mori</h3>
            <p class="mt-2 max-w-xs text-sm leading-relaxed text-dim">A pixel-cat AI companion for Windows.</p>
          </div>
        </div>
        <a href="https://mori-apis-ai.vercel.app/" target="_blank" rel="noopener noreferrer" class="btn btn-ghost min-h-11 w-full px-4 sm:w-auto" aria-label="Visit Mori's website">Visit Mori <Icon name="arrow-up-right" size={16} /></a>
      </article>
    </div>
  </section>


  <section id="faq" class="wrap py-16"><SectionHead eyebrow="Good to know" title="Hive, clearly explained." lead="A few quick answers about release status, plans, and data." /><div class="divide-y divide-line border-y border-line">{faq.map(([q, a]) => <details class="faq group px-3" data-reveal><summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 py-4 font-medium text-text">{q}<span aria-hidden="true" class="font-mono text-dim transition group-open:rotate-45">+</span></summary><p class="pb-5 text-dim">{a}</p></details>)}</div></section>

  <section id="team" class="wrap py-24 text-center"><div data-reveal><img src="/logohive.png" alt="" width="345" height="452" loading="lazy" class="mx-auto h-16 w-auto" /><span class="eyebrow mt-6">Who we are</span><h2 class="h-section mt-4">Built by Apis.</h2><p class="lead mx-auto mt-5 max-w-2xl">Apis is an independent studio building Hive. Questions? Email <a class="text-honey-2 underline-offset-4 hover:underline" href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a> or ask in the <a class="text-honey-2 underline-offset-4 hover:underline" href={DISCORD} target="_blank" rel="noopener noreferrer">Discord</a>.</p></div></section>
</Base>

<style>
  .faq summary::-webkit-details-marker { display: none; }
  .crew-order { margin: 0; padding: 0; list-style: none; }
  .crew-order li { display: grid; grid-template-columns: 2.5rem minmax(5.5rem, .4fr) 1fr; gap: .75rem; align-items: baseline; border-top: 1px solid var(--color-line); padding: .85rem 1rem; }
  .crew-order span, .crew-order em { font-family: var(--font-mono); font-style: normal; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--color-dim); }
  .crew-order strong { font-family: var(--font-display); font-size: 1.35rem; font-weight: 400; color: var(--color-text); }
</style>

<script>
  const video = document.getElementById('tour-video') as HTMLVideoElement | null;
  document.querySelectorAll<HTMLButtonElement>('[data-t]').forEach((button) => button.addEventListener('click', () => { if (!video) return; video.currentTime = Number(button.dataset.t); video.play().catch(() => {}); }));
</script>
