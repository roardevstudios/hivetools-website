---
import Base from '../layouts/Base.astro';
import { DISCORD } from '../lib/site';
import Waitlist from '../components/Waitlist.astro';
---
<Base title="Hive v0.0.1 release status" description="The public beta installer was removed. We’ll explain what changed when v0.0.1 is posted.">
  <section class="wrap grid min-h-[85dvh] place-items-center pt-28 pb-10">
    <div class="glass relative max-w-2xl overflow-hidden p-8 text-center sm:p-12" data-reveal>
      <div aria-hidden="true" class="absolute -top-24 left-1/2 size-72 -translate-x-1/2 rounded-full bg-honey/20 blur-3xl"></div>
      <div aria-hidden="true" class="relative mx-auto grid size-16 place-items-center rounded-2xl border border-honey/40 bg-honey/10 font-display text-2xl text-honey-2">01</div>
      <span class="eyebrow relative mt-6">Release status</span>
      <h1 class="relative mt-4 text-3xl font-bold sm:text-5xl">Hive v0.0.1 details are pending.</h1>
      <p class="lead relative mt-5">The public beta installer was removed. We’ll explain what changed when v0.0.1 is posted.</p>
      <div class="relative mt-6 rounded-2xl border border-line bg-panel-2/70 p-4 text-left text-sm text-dim">
        <strong class="text-text">Installer unavailable</strong><br />There is no public installer download at this time. Release updates will be posted on the changelog.
      </div>
      <div class="relative mx-auto mt-8 flex max-w-lg flex-col items-center text-left"><p class="mb-3 self-start text-sm font-medium text-text">Get an email when v0.0.1 is ready:</p><Waitlist source="download" cta="Notify me" /></div>
      <div class="relative mt-6 flex flex-col justify-center gap-3 sm:flex-row">
        <a class="btn btn-ghost" href="/changelog">Follow release updates</a>
        <a class="btn btn-ghost" href={DISCORD} target="_blank" rel="noopener noreferrer">Join the community</a>
      </div>
    </div>
  </section>
</Base>
