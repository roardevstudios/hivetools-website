---
import Base from '../layouts/Base.astro';
import { DISCORD } from '../lib/site';
---
<Base title="Public Beta Taken Down — Hive" description="The Hive v0.0.1 Public Beta is no longer available to download.">
  <section class="wrap grid min-h-[85dvh] place-items-center pt-28 pb-10">
    <div class="glass relative max-w-2xl overflow-hidden p-8 text-center sm:p-12" data-reveal>
      <div aria-hidden="true" class="absolute -top-24 left-1/2 size-72 -translate-x-1/2 rounded-full bg-honey/20 blur-3xl"></div>
      <div aria-hidden="true" class="relative mx-auto grid size-16 place-items-center rounded-2xl border border-honey/40 bg-honey/10 font-display text-2xl text-honey-2">Ⅱ</div>
      <span class="eyebrow relative mt-6">Release status · October 2026</span>
      <h1 class="relative mt-4 text-3xl font-bold sm:text-5xl">The Hive Public Beta has been taken down.</h1>
      <p class="lead relative mt-5">The v0.0.1 Public Beta is no longer available. We’ve removed its installer from this website while we prepare what comes next.</p>
      <div class="relative mt-6 rounded-2xl border border-line bg-panel-2/70 p-4 text-left text-sm text-dim">
        <strong class="text-text">Already installed Hive?</strong><br />This website change only removes the public download. It does not uninstall or alter copies already on your device. We can’t promise continued access to online services for older builds.
      </div>
      <div class="relative mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a class="btn btn-primary" href="/changelog">Read the latest updates</a>
        <a class="btn btn-ghost" href={DISCORD} target="_blank" rel="noopener noreferrer">Join the community</a>
      </div>
    </div>
  </section>
</Base>
