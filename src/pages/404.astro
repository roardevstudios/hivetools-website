---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="404 — Hive page not found" noindex>
  <section class="wrap grid min-h-[85dvh] place-items-center pt-28 pb-10 text-center">
    <div>
      <div class="relative mx-auto w-44 sm:w-56" aria-hidden="true">
        <div class="absolute inset-6 rounded-full bg-honey/30 blur-3xl"></div>
        <img id="lost-buddy" src="/hive-buddy-float.webp" alt="" width="330" height="330" class="animate-float relative w-full" />
      </div>
      <p class="eyebrow mt-6">Hive 404 · page not found</p>
      <h1 class="mt-4 font-display text-[clamp(5rem,22vw,11rem)] font-bold leading-none text-gradient">404</h1>
      <h2 class="mt-2 text-2xl font-semibold sm:text-3xl">This page wandered off.</h2>
      <p class="lead mx-auto mt-4 max-w-md">Buddy can’t find this page. It may have moved or the address may be incorrect.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a class="btn btn-primary" href="/">Return to Hive</a>
        <button type="button" class="btn btn-ghost" onclick="history.length > 1 ? history.back() : location.assign('/')"><Icon name="arrow-left" size={16} /> Go back</button>
      </div>
    </div>
  </section>
</Base>
<script>
  // Buddy leans toward the cursor
  const b = document.getElementById('lost-buddy');
  if (b && matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches)
    addEventListener('pointermove', (e) => {
      const x = (e.clientX / innerWidth - .5) * 24, y = (e.clientY / innerHeight - .5) * 24;
      b.style.translate = `${x}px ${y}px`;
    }, { passive: true });
</script>
