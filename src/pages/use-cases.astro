---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';

const cases = [
  ['Research', 'research', 'Get oriented on a topic', 'Planned from Starter: ask Hive to compare options, gather current information, and return an answer with sources you can inspect. This does not run on this website.', 'Compare these options and show me the sources.'],
  ['Planning', 'plan', 'Turn an idea into a plan', 'Shape an idea into practical next steps with Hive’s AI crew. Scout, Hive, and Pulse work together. Critic reviews the answer. Sentry watches tool calls.', 'Make a two-week launch plan for a small beta.'],
  ['Collaboration', 'chat', 'Bring the crew into one chat', 'Planned agent hand-offs bring research, a second opinion, and a review into one conversation. Scout, Hive, and Pulse work together. Critic reviews the answer. Sentry watches tool calls.', 'Ask Scout to find examples, then have Critic review the plan.'],
  ['PC control', 'pc', 'Ask for a desktop action', 'Planned from Starter. The app shows the action and waits for Allow. This page cannot do it.', 'Open Notepad and draft a checklist for me.'],
  ['Deep work', 'folder', 'Keep project work together', 'Bring project context into your Hive conversations and keep your work focused.', 'Review this project brief and list the open decisions.'],
  ['Quick help', 'bolt', 'Get help without breaking focus', 'Buddy and the notch are planned for Max. Voice on Starter is a small daily allowance of 5 sessions, not this whole workflow.', 'Summarize this and give me the next step.'],
];
const tips = [
  ['Say what success looks like', 'Share the outcome you want, not only the action you imagine taking.'],
  ['Add useful context', 'Include constraints, audience, timeframe, and any material the task depends on.'],
  ['Review before acting', 'Check the sources and plan. Approve desktop actions only when they look right.'],
];
---
<Base title="Use Cases — Put Hive to Work" description="Practical ways to use Hive for research, planning, collaboration, PC control and focused project work.">
  <PageHero eyebrow="A practical guide" title='Put your AI crew <span class="text-gradient">to work.</span>' lead="A preview of planned Hive app workflows, with plan availability called out below.">
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a class="btn btn-primary" href="/#demo-section">Try the scripted homepage demo</a>
      <a class="btn btn-ghost" href="/docs">Explore the guide</a>
    </div>
  </PageHero>

  <section class="wrap">
    <p class="mb-6 rounded-xl border border-honey/30 bg-honey/10 px-4 py-3 text-sm text-honey-2">These are planned workflows, not a downloadable build. Research and PC actions are Starter. Buddy, the notch, and HiveBox are Plus. Nothing here runs on this website.</p>
    <div class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-2 md:overflow-visible md:px-0 lg:grid-cols-3">
      {cases.map(([tag, icon, t, d, q], i) => (
        <article class="glass group flex w-[85%] shrink-0 snap-center flex-col p-6 transition duration-500 hover:-translate-y-1 hover:border-honey/40 md:w-auto" data-reveal style={`--i:${i % 3}`}>
          <div class="flex items-center justify-between">
            <span class="grid size-11 place-items-center rounded-xl border border-honey/25 bg-honey/10 text-honey-2" aria-hidden="true"><Icon name={icon as any} size={22} /></span>
            <span class="text-xs uppercase tracking-widest text-dim">0{i + 1} / {tag}</span>
          </div>
          <h2 class="mt-5 text-xl font-semibold">{t}</h2>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-dim">{d}</p>
          <p class="mt-5 rounded-2xl border border-line bg-panel-2 px-4 py-3 text-sm text-text">“{q}”</p>
        </article>
      ))}
    </div>
    <p class="mt-2 flex items-center justify-center gap-1.5 text-center text-xs text-dim md:hidden">Swipe to see more <Icon name="arrow-right" size={14} /></p>
  </section>

  <section class="wrap py-20">
    <h2 class="h-section mb-10" data-reveal>Get better results.</h2>
    <ol class="grid gap-4 md:grid-cols-3">
      {tips.map(([t, d], i) => (
        <li class="border-t-2 border-honey/50 pt-5" data-reveal style={`--i:${i}`}>
          <span class="font-display text-honey-2">0{i + 1}</span>
          <h3 class="mt-2 text-lg font-semibold">{t}</h3>
          <p class="mt-2 text-sm text-dim">{d}</p>
        </li>
      ))}
    </ol>
    <div class="mt-10 rounded-3xl border border-mint/30 bg-mint/[.06] p-6" data-reveal>
      <h3 class="font-semibold">You stay in control of your PC</h3>
      <p class="mt-2 text-sm text-soft/90">Website examples are illustrative. Real desktop actions run in the Hive app and require your approval. Your chats stay on your device.</p>
    </div>
  </section>

  <section class="wrap">
    <div class="glass p-8 text-center sm:p-12" data-reveal>
      <h2 class="h-section">See how the workflow feels.</h2>
      <p class="lead mx-auto mt-4 max-w-xl">Open the scripted chat simulation on the homepage. The public beta installer was removed. We’ll explain what changed when v0.0.1 is posted.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a class="btn btn-primary" href="/#demo-section">Try the demo</a>
        <a class="btn btn-ghost" href="/changelog">Read release updates</a>
      </div>
    </div>
  </section>
</Base>
