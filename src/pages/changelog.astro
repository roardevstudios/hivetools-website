---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { DISCORD } from '../lib/site';

const release = {
  version: 'v0.0.1',
  title: 'Hive v0.0.1 is coming soon.',
  date: 'Release date to be announced',
  items: [
    ['First public release', 'We are preparing Hive v0.0.1 for its first public release.'],
    ['What to expect', 'A Windows desktop AI workspace for research, agent workflows, and PC actions you approve.'],
    ['Launch details', 'The installer and full release notes will be posted here when v0.0.1 is ready.'],
  ],
};
---
<Base title="Hive v0.0.1 — Coming Soon" description="Hive v0.0.1 is the only upcoming Hive release. Follow the changelog for its launch date and installer.">
  <PageHero eyebrow="Release updates" title="Hive v0.0.1 is coming soon." lead="We are preparing Hive’s first public release. The launch date and installer will be announced here.">
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a class="btn btn-primary" href={DISCORD} target="_blank" rel="noopener noreferrer">Join the community</a>
      <a class="btn btn-ghost" href="/download">Release status</a>
    </div>
  </PageHero>
  <section class="wrap">
    <ol class="relative border-l border-line pl-6 sm:pl-10">
      <li class="relative pb-16 last:pb-0" data-reveal>
        <span class="absolute -left-[1.95rem] top-1.5 size-3.5 rounded-full border-2 border-ink bg-honey shadow-[0_0_0_6px_rgb(240_138_36/.2)] sm:-left-[2.95rem]"></span>
        <div class="flex flex-wrap items-center gap-2">
          <span class="font-display text-2xl font-bold text-text">{release.version}</span>
          <span class="rounded-full border border-honey/30 bg-honey/10 px-2.5 py-0.5 text-xs text-honey-2">Coming soon</span>
        </div>
        <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">{release.title}</h2>
        <p class="mt-1 text-sm text-dim">{release.date}</p>
        <ul class="mt-6 grid max-w-3xl gap-3">
          {release.items.map(([label, detail]) => (
            <li class="rounded-2xl border border-line bg-panel/60 p-4 text-sm"><strong class="text-text">{label}.</strong> <span class="text-dim">{detail}</span></li>
          ))}
        </ul>
        <a href={DISCORD} target="_blank" rel="noopener noreferrer" class="btn btn-ghost mt-6">Join the community</a>
      </li>
    </ol>
  </section>
</Base>
