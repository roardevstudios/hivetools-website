---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { DISCORD } from '../lib/site';

const release = { version: 'v0.0.1', title: 'Hive v0.0.1 for Windows', date: 'Available now' };
---
<Base title="Hive changelog and release status" description="Hive release notes and public release status.">
  <PageHero eyebrow="Release updates" title="Hive release notes." lead="Hive v0.0.1 is available for Windows on the download page.">
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a class="btn btn-primary" href={DISCORD} target="_blank" rel="noopener noreferrer">Join the community</a>
      <a class="btn btn-ghost" href="/download">Release status</a>
    </div>
  </PageHero>
  <section class="wrap">
    <ol class="relative border-l border-line pl-6 sm:pl-10">
      <li class="relative pb-16 last:pb-0" data-reveal>
        <span class="absolute -left-[1.95rem] top-1.5 size-3.5 rounded-full border-2 border-ink bg-honey shadow-[0_0_0_6px_rgb(240_138_36/.2)] sm:-left-[2.95rem]"></span>
        <div class="flex flex-wrap items-center gap-2">
          <span class="font-display text-2xl font-bold text-text">{release.version}</span>
          <span class="rounded-full border border-honey/30 bg-honey/10 px-2.5 py-0.5 text-xs text-honey-2">Released</span>
        </div>
        <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">{release.title}</h2>
        <p class="mt-1 text-sm text-dim">{release.date}</p>
        <p class="mt-6 max-w-3xl rounded-2xl border border-line bg-panel/60 p-4 text-sm text-dim">Windows installer and release notes are on the download page.</p>
        <a href={DISCORD} target="_blank" rel="noopener noreferrer" class="btn btn-ghost mt-6">Join the community</a>
      </li>
    </ol>
  </section>
</Base>
