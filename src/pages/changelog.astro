---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { DISCORD } from '../lib/site';

const releases = [
  {
    version: 'v0.0.2',
    title: 'Bonsai only',
    date: 'November 7, 2026',
    body: [
      'Installer: Hive-Setup-v0.0.2.exe, linked from the download page.',
      'The only model in this installer is Bonsai. Free still includes cited research, PC actions with Allow or Deny, agent tools, and swarm.',
      'Free is 25,000 chat tokens and 5 voice sessions a day. Pro is 50,000 tokens and 25 voice sessions. Max is 2,000,000 tokens and unlimited voice. Prices stay €0, €4.99, and €22.99. Checkout is closed.',
      'Buddy and HiveBox are not in this installer. The publisher is unsigned, so Windows SmartScreen can report an unknown publisher. macOS and Linux builds are not in this installer.',
    ],
  },
  {
    version: 'v0.0.1.1',
    title: 'Hive for Windows',
    date: 'October 29, 2026',
    body: [
      'Installer: Hive-Setup-v0.0.1.1.exe. This release is superseded by v0.0.2.',
      'That installer included a free tier with no card, core chat, cited web research, agent tools, and PC actions that ask for Allow or Deny.',
      'Buddy and the desktop notch were not in that installer. Paid checkout was closed. There was no code-signing certificate.',
    ],
  },
];
---
<Base title="Hive changelog and release status" description="Hive release notes and public release status.">
  <PageHero eyebrow="Release updates" title="Hive release notes." lead="Hive release is available for Windows on the download page.">
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a class="btn btn-primary" href={DISCORD} target="_blank" rel="noopener noreferrer">Join the community</a>
      <a class="btn btn-ghost" href="/download">Release status</a>
    </div>
  </PageHero>
  <section class="wrap">
    <ol class="relative border-l border-line pl-6 sm:pl-10">
      {releases.map((release) => (
      <li class="relative pb-16 last:pb-0" data-reveal>
        <span class="absolute -left-[1.7rem] top-2 size-3 border border-honey bg-honey sm:-left-[2.7rem]"></span>
        <div class="flex flex-wrap items-center gap-2">
          <span class="font-display text-2xl font-bold text-text">{release.version}</span>
          <span class="border border-honey/40 px-2 py-0.5 font-mono text-[.68rem] uppercase tracking-[.12em] text-honey">Released</span>
        </div>
        <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">{release.title}</h2>
        <p class="mt-1 text-sm text-dim">{release.date}</p>
        <div class="mt-6 max-w-3xl border border-line bg-panel p-4 text-sm leading-relaxed text-dim">
          {release.body.map((paragraph) => <p class="mt-3 first:mt-0">{paragraph}</p>)}
        </div>
        <a href={DISCORD} target="_blank" rel="noopener noreferrer" class="btn btn-ghost mt-6">Join the community</a>
      </li>
      ))}
    </ol>
  </section>
</Base>
