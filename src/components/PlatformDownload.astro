<style>
  .hive-platforms {
    display: flex; flex-direction: column; gap: 10px;
    width: 100%; max-width: 420px; margin: 0 auto; text-align: left;
  }
  .hive-row {
    position: relative; display: flex; align-items: center; gap: 14px;
    width: 100%; padding: 14px 16px; box-sizing: border-box; overflow: hidden;
    background: rgba(255, 255, 255, .03); border: 1px solid #1f2937; border-radius: 12px;
    color: #f3f4f6; font: inherit; text-align: left;
    transition: background-color .2s ease, border-color .2s ease, transform .1s ease;
  }
  button.hive-row { cursor: pointer; }
  button.hive-row.live:hover:not(.loading):not(.done) { background: rgba(255, 255, 255, .06); border-color: #374151; }
  button.hive-row.live:active:not(.loading):not(.done) { transform: scale(.99); }
  button.hive-row:focus-visible { outline: 2px solid #0078d4; outline-offset: 2px; }
  .hive-row.soon { opacity: .55; }
  .hive-icon {
    display: grid; place-items: center; width: 36px; height: 36px; flex-shrink: 0;
    border-radius: 10px; background: rgba(255, 255, 255, .05); position: relative; z-index: 2;
  }
  .hive-icon svg { width: 18px; height: 18px; fill: #e5e7eb; }
  .hive-row.live .hive-icon { background: rgba(0, 120, 212, .15); }
  .hive-row.live .hive-icon svg { fill: #60a5fa; }
  .hive-text { display: flex; flex-direction: column; min-width: 0; position: relative; z-index: 2; }
  .hive-name { font-size: 15px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hive-sub { font-size: 12px; color: #9ca3af; margin-top: 2px; }
  .hive-tag {
    margin-left: auto; flex-shrink: 0; font-size: 11px; font-weight: 600; letter-spacing: .02em;
    padding: 4px 9px; border-radius: 999px; background: rgba(255, 255, 255, .06); color: #9ca3af;
    position: relative; z-index: 2;
  }
  .hive-tag.live-tag, .hive-row.live .hive-tag { background: rgba(16, 124, 65, .2); color: #34d399; }
  .hive-progress {
    position: absolute; left: 0; bottom: 0; height: 3px; width: 0%;
    background: #0078d4; transition: width .1s linear; z-index: 1;
  }
  .hive-row.loading { background: rgba(0, 120, 212, .1); border-color: #0078d4; }
  .hive-row.done { background: rgba(16, 124, 65, .1); border-color: #107c41; }
  .hive-row.done .hive-name { color: #34d399; }
</style>

<script>
  const winBtn = document.getElementById('winBtn') as HTMLButtonElement | null;
  const winLabel = document.getElementById('winLabel') as HTMLElement | null;
  const winProgress = document.getElementById('winProgress') as HTMLElement | null;

  winBtn?.addEventListener('click', () => {
    if (!winBtn || !winLabel || !winProgress) return;
    if (winBtn.classList.contains('loading') || winBtn.classList.contains('done')) return;

    // Real download: start the installer, then show progress and a done state.
    const link = document.createElement('a');
    link.href = winBtn.dataset.href || '';
    link.rel = 'noopener';
    link.click();

    winBtn.classList.add('loading');
    let count = 0;
    const timer = window.setInterval(() => {
      count += 4;
      winProgress.style.width = `${Math.min(count, 100)}%`;
      winLabel.textContent = `Starting download... ${Math.min(count, 100)}%`;
      if (count >= 100) {
        window.clearInterval(timer);
        winBtn.classList.remove('loading');
        winBtn.classList.add('done');
        winLabel.textContent = 'Download started';
        window.setTimeout(() => {
          winBtn.classList.remove('done');
          winProgress.style.width = '0%';
          winLabel.textContent = 'Windows 10 / 11';
        }, 4000);
      }
    }, 60);
  });
</script>
