<!-- Platform download selector. Windows is live; macOS and Linux show as coming soon. -->
<div class="hive-download-card" id="hiveCard">
  <div class="hive-trigger" id="hiveTrigger" role="button" tabindex="0" aria-expanded="false" aria-controls="hivePlatforms">
    <div class="hive-brand-info">
      <span class="title-primary">Get Hive</span>
      <span class="title-sub">Select your platform</span>
    </div>
    <svg class="caret-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10l5 5 5-5H7z"/></svg>
  </div>

  <div class="hive-collapse-drawer" id="hivePlatforms">
    <div class="drawer-inner">
      <div class="platform-list">
        <button class="hive-btn" id="winBtn" type="button" data-href="https://github.com/Hive-AI-APP/Hive-Public-Hive/releases/download/v0.0.1.1/Hive-Setup.exe">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M0 3.449L9.75 2.1v9.45H0V3.449zM0 12.45h9.75v9.45L0 20.551v-8.1zM10.8 1.95L24 0v11.55H10.8V1.95zM10.8 12.45H24v11.55l-13.2-1.95v-9.6z"/></svg>
          <span class="label" id="winLabel">Windows 10 / 11</span>
          <span class="badge-live">Live</span>
          <div class="progress-track" id="winProgress"></div>
        </button>

        <button class="hive-btn soon" type="button" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 4.17c.66-.81 1.11-1.93.99-3.06-1 .04-2.21.67-2.93 1.49-.62.69-1.16 1.84-1.01 2.96 1.12.09 2.27-.56 2.95-1.39z"/></svg>
          <span class="label">macOS Apple Silicon</span>
          <span class="badge-soon">Soon</span>
        </button>

        <button class="hive-btn soon" type="button" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2c-3.12 0-5 2.1-5 4.38 0 1 .3 2 .85 2.8C7.15 10.45 6.5 12 6.5 13.5c0 3.04 2.24 5.5 5.5 5.5s5.5-2.46 5.5-5.5c0-1.5-.65-3.05-1.35-4.32.55-.8.85-1.8.85-2.8C17 4.1 15.12 2 12 2zm-2.5 5c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm5 0c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-5.48 9.53c.6-.74 1.63-1.28 2.98-1.28 1.34 0 2.38.54 2.98 1.28-.48.6-1.5.97-2.98.97-1.48 0-2.5-.37-2.98-.97z"/></svg>
          <span class="label">Linux x64 AppImage</span>
          <span class="badge-soon">Soon</span>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .hive-download-card {
    background: #111827;
    border: 1px solid #1f2937;
    border-radius: 14px;
    width: 100%;
    max-width: 340px;
    margin: 0 auto;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    text-align: left;
  }
  .hive-trigger {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 20px; cursor: pointer; user-select: none;
    transition: background-color .2s ease;
  }
  .hive-trigger:hover { background-color: rgba(255, 255, 255, .02); }
  .hive-trigger:focus-visible { outline: 2px solid #0078d4; outline-offset: -2px; }
  .hive-brand-info { display: flex; flex-direction: column; }
  .title-primary { color: #f3f4f6; font-size: 15px; font-weight: 600; }
  .title-sub { color: #9ca3af; font-size: 12px; margin-top: 2px; }
  .caret-icon { width: 18px; height: 18px; fill: #9ca3af; transition: transform .3s cubic-bezier(.4, 0, .2, 1), fill .2s ease; }
  .hive-trigger:hover .caret-icon { fill: #f3f4f6; }
  .hive-collapse-drawer { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s cubic-bezier(.4, 0, .2, 1); }
  .drawer-inner { overflow: hidden; min-height: 0; }
  .hive-download-card.open .hive-collapse-drawer { grid-template-rows: 1fr; }
  .hive-download-card.open .caret-icon { transform: rotate(180deg); }
  .platform-list { padding: 4px 12px 16px; display: flex; flex-direction: column; gap: 8px; border-top: 1px solid #1f2937; }
  .hive-btn {
    position: relative; display: flex; align-items: center; gap: 12px;
    width: 100%; height: 44px; padding: 0 16px; box-sizing: border-box;
    background: rgba(255, 255, 255, .03); border: 1px solid #1f2937; border-radius: 8px;
    color: #f3f4f6; font: 500 14px/1 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    cursor: pointer; overflow: hidden;
    transition: background-color .2s ease, border-color .2s ease, transform .1s ease;
  }
  .hive-btn:hover:not(.loading):not(.done):not(.soon) { background: rgba(255, 255, 255, .07); border-color: #374151; }
  .hive-btn:active:not(.loading):not(.done):not(.soon) { transform: scale(.98); }
  .hive-btn svg { width: 16px; height: 16px; fill: currentColor; flex-shrink: 0; position: relative; z-index: 2; }
  .hive-btn .label { position: relative; z-index: 2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hive-btn.soon { opacity: .5; cursor: not-allowed; }
  .badge-soon, .badge-live {
    margin-left: auto; font-size: 11px; padding: 2px 8px; border-radius: 4px; position: relative; z-index: 2;
  }
  .badge-soon { background: rgba(255, 255, 255, .06); color: #9ca3af; }
  .badge-live { background: rgba(16, 124, 65, .18); color: #34d399; }
  .progress-track {
    position: absolute; bottom: 0; left: 0; height: 3px; width: 0%;
    background: #0078d4; transition: width .1s linear; z-index: 1;
  }
  .hive-btn.loading { background: rgba(0, 120, 212, .1); border-color: #0078d4; cursor: default; }
  .hive-btn.done { background: rgba(16, 124, 65, .1); border-color: #107c41; color: #34d399; cursor: default; }
</style>

<script>
  const card = document.getElementById('hiveCard') as HTMLElement | null;
  const trigger = document.getElementById('hiveTrigger') as HTMLElement | null;
  const winBtn = document.getElementById('winBtn') as HTMLButtonElement | null;
  const winLabel = document.getElementById('winLabel') as HTMLElement | null;
  const winProgress = document.getElementById('winProgress') as HTMLElement | null;

  const setOpen = (open: boolean) => {
    card?.classList.toggle('open', open);
    trigger?.setAttribute('aria-expanded', String(open));
  };

  trigger?.addEventListener('click', () => setOpen(!card?.classList.contains('open')));
  trigger?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); setOpen(!card?.classList.contains('open')); }
  });

  winBtn?.addEventListener('click', (event) => {
    event.stopPropagation();
    if (!winBtn || !winLabel || !winProgress) return;
    if (winBtn.classList.contains('loading') || winBtn.classList.contains('done')) return;

    // Real download: start the installer, then show progress and a done state.
    const link = document.createElement('a');
    link.href = winBtn.dataset.href || '';
    link.rel = 'noopener';
    link.click();

    winBtn.classList.add('loading');
    let count = 0;
    const timer = window.setInterval(() => {
      count += 4;
      winProgress.style.width = `${Math.min(count, 100)}%`;
      winLabel.textContent = `Starting download... ${Math.min(count, 100)}%`;
      if (count >= 100) {
        window.clearInterval(timer);
        winBtn.classList.remove('loading');
        winBtn.classList.add('done');
        winLabel.textContent = 'Download started';
        window.setTimeout(() => {
          winBtn.classList.remove('done');
          winProgress.style.width = '0%';
          winLabel.textContent = 'Windows 10 / 11';
        }, 4000);
      }
    }, 60);
  });
</script>
