---
import { NAV, DISCORD, DOWNLOAD_URL } from '../lib/site';
const path = Astro.url.pathname.replace(/\.html$/, '');
---
<header id="site-nav" class="fixed inset-x-0 top-0 z-50 px-3 pt-3 transition-all duration-500">
  <nav class="nav mx-auto grid h-14 max-w-6xl [grid-template-columns:minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-2 rounded-2xl border border-transparent px-3 transition-all duration-500" aria-label="Main">
    <a href="/" class="flex items-center gap-2.5 font-display text-lg font-bold text-text">
      <img src="/hive_symbol.png" alt="" width="30" height="30" class="h-[30px] w-auto object-contain" /> Hive
    </a>
    <div class="col-start-2 hidden items-center justify-center gap-0 lg:flex">
      {NAV.map((l) => (
        <a href={l.href} class:list={['whitespace-nowrap rounded-full px-2 py-1.5 text-sm transition hover:bg-white/5 hover:text-text', path === l.href ? 'text-text' : 'text-dim']}>{l.label}</a>
      ))}
    </div>
    <div class="nav-actions col-start-3 flex items-center justify-self-end gap-2">
      <a id="nav-auth-link" href="/auth" class="hidden shrink-0 whitespace-nowrap text-sm text-dim hover:text-text sm:inline">Sign in</a>
      <a href={DOWNLOAD_URL} class="btn btn-primary hidden shrink-0 whitespace-nowrap !min-h-9 !px-3 sm:inline-flex">Download</a>
      <button id="menu-btn" type="button" class="relative grid size-11 place-items-center rounded-xl lg:hidden" aria-label="Open menu" aria-controls="menu" aria-expanded="false">
        <span class="bar absolute h-0.5 w-5 -translate-y-1.5 rounded bg-text transition duration-300"></span>
        <span class="bar absolute h-0.5 w-5 translate-y-1.5 rounded bg-text transition duration-300"></span>
      </button>
    </div>
  </nav>
</header>

<div id="menu" class="fixed inset-0 z-40 flex flex-col bg-ink/95 px-6 pt-24 pb-10 backdrop-blur-2xl lg:hidden" hidden>
  <nav class="flex flex-col" aria-label="Mobile">
    {[...NAV, { href: '/profile', label: 'Profile' }, { href: '/auth', label: 'Sign in' }].map((l, i) => (
      <a id={l.href === '/auth' ? 'mobile-auth-link' : undefined} href={l.href} style={`--i:${i}`} class="menu-link border-b border-line py-4 font-display text-2xl font-semibold text-text">{l.label}</a>
    ))}
  </nav>
  <div class="mt-auto grid gap-3"><a href={DOWNLOAD_URL} class="btn btn-primary w-full !min-h-13 text-base">Download</a><a href={DISCORD} target="_blank" rel="noopener noreferrer" class="btn btn-ghost w-full !min-h-13 text-base">Discord community</a></div>
</div>

<style>
  #site-nav.scrolled .nav { border-color: var(--color-line); background: rgb(15 17 22 / .75); backdrop-filter: blur(18px); }
  #menu .menu-link { opacity: 0; transform: translateY(16px); transition: all .5s var(--ease-spring) calc(var(--i) * 45ms); }
  #menu.open .menu-link { opacity: 1; transform: none; }
  #menu-btn[aria-expanded='true'] .bar:first-child { transform: rotate(45deg); }
  #menu-btn[aria-expanded='true'] .bar:last-child { transform: rotate(-45deg); }
</style>

<script>
  const header = document.getElementById('site-nav')!;
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('menu')!;
  const onScroll = () => header.classList.toggle('scrolled', scrollY > 12);
  addEventListener('scroll', onScroll, { passive: true }); onScroll();
  const setOpen = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) { menu.hidden = false; requestAnimationFrame(() => menu.classList.add('open')); }
    else { menu.classList.remove('open'); menu.hidden = true; }
  };
  btn.addEventListener('click', () => setOpen(menu.hidden));
  menu.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) setOpen(false); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) setOpen(false); });

  const updateAuthLink = (signedIn: boolean) => {
    const desktop = document.getElementById('nav-auth-link');
    const mobile = document.getElementById('mobile-auth-link');
    if (desktop) { desktop.textContent = signedIn ? 'My account' : 'Sign in'; desktop.setAttribute('href', signedIn ? '/profile' : '/auth'); }
    if (mobile) { mobile.textContent = signedIn ? 'My account' : 'Sign in'; mobile.setAttribute('href', signedIn ? '/profile' : '/auth'); }
  };
  const authClient = (window as any).hiveSupabase;
  if (authClient) {
    authClient.auth.onAuthStateChange((_event: string, session: any) => updateAuthLink(!!session?.user));
    authClient.auth.getSession().then(({ data }: any) => updateAuthLink(!!data?.session?.user)).catch(() => updateAuthLink(false));
  }
</script>
