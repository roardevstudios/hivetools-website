---
import { DISCORD } from '../lib/site';
import Waitlist from './Waitlist.astro';
---
<section class="wrap" id="beta">
  <div class="glass relative overflow-hidden p-8 sm:p-12" data-reveal>
    <div aria-hidden="true" class="absolute -right-24 -top-24 size-72 rounded-full bg-honey/20 blur-3xl"></div>
    <span class="eyebrow"><span class="live-dot"></span> Release update</span>
    <h2 class="h-section mt-4 max-w-2xl">The Public Beta has been taken down.</h2>
    <p class="lead mt-5 max-w-2xl">The v0.0.1 installer has been removed from this website and is no longer available to download. We’re preparing what comes next. Existing app installs are not affected by this website update.</p>
    <div class="relative mt-8"><Waitlist source="beta-notice" cta="Notify me" compact /></div>
    <div class="mt-5 flex flex-wrap gap-4 text-sm">
      <a href="/changelog" class="text-honey-2 underline-offset-4 hover:underline">Read the changelog →</a>
      <a href={DISCORD} target="_blank" rel="noopener noreferrer" class="text-honey-2 underline-offset-4 hover:underline">Join the community →</a>
    </div>
  </div>
</section>
