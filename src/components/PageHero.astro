---
interface Props { eyebrow: string; title: string; lead?: string }
const { eyebrow, title, lead } = Astro.props;
---
<header class="relative overflow-hidden pt-32 pb-12 sm:pt-40">
  <div aria-hidden="true" class="absolute left-1/2 top-0 -z-10 h-[420px] w-[900px] -translate-x-1/2 rounded-full opacity-50 blur-3xl" style="background: radial-gradient(closest-side, rgb(240 138 36 / .3), transparent)"></div>
  <div class="wrap" data-reveal>
    <span class="eyebrow">{eyebrow}</span>
    <h1 class="mt-4 max-w-3xl text-4xl font-bold leading-[1.02] sm:text-6xl" set:html={title} />
    {lead && <p class="lead mt-5 max-w-2xl">{lead}</p>}
    <slot />
  </div>
</header>
