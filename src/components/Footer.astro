---
import { DISCORD, SUPPORT_EMAIL, X_URL } from '../lib/site';
const cols = [
  { h: 'Product', links: [['/#features', 'Features'], ['/#safety', 'Safety'], ['/use-cases', 'Use cases'], ['/pricing', 'Pricing']] },
  { h: 'Support', links: [[`mailto:${SUPPORT_EMAIL}`, SUPPORT_EMAIL], [DISCORD, 'Discord community & tickets'], [X_URL, 'Hive on X'], ['/docs', 'Docs']] },
  { h: 'Company', links: [['/#team', 'About Apis'], ['/changelog', 'Changelog'], ['/docs#privacy', 'Privacy'], ['/docs#terms', 'Terms']] },
];
---
<footer class="footer-glow relative mt-24 border-t border-line">
  <div class="wrap grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <div class="flex items-center gap-2.5 font-display text-lg font-bold text-text"><img src="/hive_symbol.png" alt="" width="26" height="26" class="h-[26px] w-auto object-contain" /> Hive</div>
      <p class="mt-3 max-w-xs text-sm text-dim">The desktop AI that does things. By <strong class="text-text">Apis</strong>.</p>
      <a href="/download" class="btn btn-ghost mt-6 !min-h-9 !px-4 text-xs">Download</a>
    </div>
    {cols.map((c) => (
      <div>
        <h4 class="mb-3 text-xs font-semibold uppercase tracking-[.16em] text-dim">{c.h}</h4>
        <ul class="space-y-0.5 text-sm">
          {c.links.map(([href, label]) => (
            <li><a href={href} class="-my-1 inline-flex min-h-10 items-center break-words py-2 text-soft/80 transition hover:text-honey-2" {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="wrap flex flex-col gap-2 border-t border-line py-6 text-xs text-dim sm:flex-row sm:justify-between">
    <span>© {new Date().getFullYear()} Apis. All rights reserved.</span>
    <span>Windows 10 / 11</span>
  </div>
</footer>
