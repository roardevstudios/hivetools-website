---
import { DISCORD, X_URL, SITE_URL, SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY } from '../lib/site';
interface Props { plan?: 'hive_starter' | 'hive_plus' | 'hive_max' | 'tokens_plus' | 'token_max'; compact?: boolean; cta?: string; source?: string }
const { plan, compact = false, cta = 'Join the waitlist', source = 'site' } = Astro.props;
const shareText = 'Hive is a Windows AI workspace: cited research, an AI crew, and PC control that always asks first. Joining the waitlist 🐝';
const shareUrl = `${SITE_URL}/?ref=share`;
---
<div class="waitlist" data-plan={plan ?? ''} data-source={source} data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY}>
  <form class:list={['wl-form flex flex-col gap-2 sm:flex-row', compact ? 'max-w-md' : 'max-w-lg']} novalidate>
    <label class="sr-only" for={`wl-${source}`}>Email address</label>
    <input id={`wl-${source}`} name="email" type="email" required autocomplete="email" inputmode="email" placeholder="you@example.com"
      class="min-h-12 flex-1 rounded-full border border-line bg-panel/80 px-5 text-base text-text placeholder:text-dim focus:border-honey/60 focus:outline-none" />
    <button type="submit" class="btn btn-primary !min-h-12 !px-6 text-base">{cta}</button>
  </form>
  <p class="wl-note mt-2 text-xs text-dim" aria-live="polite">Email me when v0.0.1 is ready. No spam; unsubscribe at any time.</p>
  <div class="wl-done mt-1 hidden">
    <p class="font-medium text-text">You’re on the list. 🐝</p>
    <p class="mt-1 text-sm text-dim">Follow the build on Discord or X.</p>
    <div class="mt-3 flex flex-wrap gap-2">
      <a class="btn btn-ghost !min-h-10 !px-4" target="_blank" rel="noopener noreferrer" href={`https://x.com/intent/post?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`}>Share on X</a>
      <a class="btn btn-ghost !min-h-10 !px-4" target="_blank" rel="noopener noreferrer" href={`https://www.reddit.com/submit?url=${encodeURIComponent(shareUrl)}&title=${encodeURIComponent('Hive: a Windows AI workspace with PC control that asks first')}`}>Share on Reddit</a>
      <button type="button" class="wl-copy btn btn-ghost !min-h-10 !px-4" data-link={shareUrl}>Copy link</button>
      <a class="btn btn-ghost !min-h-10 !px-4" target="_blank" rel="noopener noreferrer" href={DISCORD}>Join Discord</a>
      <a class="btn btn-ghost !min-h-10 !px-4" target="_blank" rel="noopener noreferrer" href={X_URL}>Follow on X</a>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.waitlist').forEach((root) => {
    const form = root.querySelector('form')!;
    const note = root.querySelector<HTMLElement>('.wl-note')!;
    const done = root.querySelector<HTMLElement>('.wl-done')!;
    const btn = form.querySelector('button')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim().toLowerCase();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { note.textContent = 'Please enter a valid email address.'; note.style.color = '#fca5a5'; return; }
      btn.disabled = true; btn.textContent = 'Joining…';
      try {
        const res = await fetch(`${root.dataset.url}/rest/v1/waitlist_emails`, {
          method: 'POST',
          headers: { apikey: root.dataset.key!, Authorization: `Bearer ${root.dataset.key}`, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
          body: JSON.stringify({ email, plan_interest: root.dataset.plan || null }),
        });
        // 409 = already on the list, which is fine.
        if (!res.ok && res.status !== 409) throw new Error(String(res.status));
        form.classList.add('hidden'); note.classList.add('hidden'); done.classList.remove('hidden');
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) done.animate?.([{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }], { duration: 450, easing: 'cubic-bezier(.2,.8,.2,1)' });
      } catch {
        note.textContent = 'Something went wrong. Please try again, or join us on Discord.'; note.style.color = '#fca5a5';
        btn.disabled = false; btn.textContent = 'Try again';
      }
    });
    root.querySelector<HTMLButtonElement>('.wl-copy')?.addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      try { await navigator.clipboard.writeText(b.dataset.link!); b.textContent = 'Copied!'; } catch { b.textContent = b.dataset.link!; }
    });
  });
</script>
