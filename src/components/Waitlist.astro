---
import { DISCORD, X_URL, SITE_URL, SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY } from '../lib/site';
interface Props { plan?: 'hive_starter' | 'hive_plus' | 'hive_max' | 'tokens_plus' | 'token_max'; compact?: boolean; cta?: string; source?: string }
const { plan, compact = false, cta = 'Join the waitlist', source = 'site' } = Astro.props;
const shareText = 'Hive is a Windows AI workspace: cited research, an AI crew, and PC control that always asks first. Joining the waitlist 🐝';
const shareUrl = `${SITE_URL}/?ref=share`;
---
<div class="waitlist" data-plan={plan ?? ''} data-source={source} data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY}>
  <form class:list={['wl-form flex flex-col gap-2 sm:flex-row', compact ? 'max-w-md' : 'max-w-lg']} novalidate>
    <label class="sr-only" for={`wl-${source}`}>Email address</label>
    <input id={`wl-${source}`} name="email" type="email" required autocomplete="email" inputmode="email" placeholder="you@example.com"
      class="min-h-12 flex-1 rounded-full border border-line bg-panel/80 px-5 text-base text-text placeholder:text-dim focus:border-honey/60 focus:outline-none" />
    <button type="submit" class="btn btn-primary !min-h-12 !px-6 text-base">{cta}</button>
  </form>
  <label class="mt-3 flex items-start gap-2 text-xs text-dim">
    <input class="mt-0.5" name="release-consent" type="checkbox" required />
    <span>I agree to receive Hive release updates by email. I can unsubscribe at any time.</span>
  </label>
  <p class="wl-note mt-2 text-xs text-dim" aria-live="polite">We’ll email release updates from apis.new.world@gmail.com.</p>
  <dialog class="wl-success" aria-labelledby={`wl-success-title-${source}`} aria-describedby={`wl-success-copy-${source}`}>
    <div class="wl-success-card">
      <button type="button" class="wl-close" aria-label="Close confirmation">×</button>
      <div class="wl-celebration" aria-hidden="true">
        <span class="wl-spark wl-spark-one">✦</span>
        <span class="wl-spark wl-spark-two">✧</span>
        <span class="wl-spark wl-spark-three">✦</span>
        <div class="wl-mascot-wrap"><img class="wl-mascot" src="/hive-buddy-float.webp" width="112" height="112" alt="" /></div>
        <span class="wl-check"><svg viewBox="0 0 32 32" fill="none"><path d="m7 16.5 6 6L25.5 10" /></svg></span>
      </div>
      <p class="wl-success-eyebrow">SIGNUP CONFIRMED</p>
      <h2 id={`wl-success-title-${source}`}>You’re in the Hive.</h2>
      <p class="wl-success-copy" id={`wl-success-copy-${source}`}>We’ve saved your request. We’ll email you when the v0.0.1 release details are posted.</p>
      <p class="wl-success-follow">Follow the build while you wait.</p>
      <div class="wl-success-links">
        <a class="btn btn-ghost !min-h-10 !px-4" target="_blank" rel="noopener noreferrer" href={`https://x.com/intent/post?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`}>Share on X</a>
        <a class="btn btn-ghost !min-h-10 !px-4" target="_blank" rel="noopener noreferrer" href={`https://www.reddit.com/submit?url=${encodeURIComponent(shareUrl)}&title=${encodeURIComponent('Hive: a Windows AI workspace with PC control that asks first')}`}>Share on Reddit</a>
        <button type="button" class="wl-copy btn btn-ghost !min-h-10 !px-4" data-link={shareUrl}>Copy link</button>
        <a class="btn btn-ghost !min-h-10 !px-4" target="_blank" rel="noopener noreferrer" href={DISCORD}>Join Discord</a>
        <a class="btn btn-ghost !min-h-10 !px-4" target="_blank" rel="noopener noreferrer" href={X_URL}>Follow on X</a>
      </div>
      <button type="button" class="wl-close-action">Back to Hive</button>
    </div>
  </dialog>
</div>

<style>
  .wl-success { width: min(92vw, 620px); max-width: none; max-height: min(88vh, 760px); overflow: auto; padding: 0; color: #f7f4ee; background: transparent; border: 0; }
  .wl-success::backdrop { background: rgb(4 6 10 / .78); backdrop-filter: blur(9px); }
  .wl-success[open] { animation: wl-dialog-in 360ms cubic-bezier(.2,.8,.2,1) both; }
  .wl-success-card { position: relative; overflow: hidden; padding: 34px clamp(20px, 6vw, 52px) 30px; text-align: center; border: 1px solid rgb(255 255 255 / .12); border-radius: 28px; background: radial-gradient(ellipse at 50% 0%, rgb(240 138 36 / .13), transparent 48%), #0c0e13; box-shadow: 0 28px 100px rgb(0 0 0 / .55); }
  .wl-close { position: absolute; z-index: 2; top: 12px; right: 14px; display: grid; width: 38px; height: 38px; place-items: center; border: 1px solid rgb(255 255 255 / .12); border-radius: 50%; color: #b7bbc4; background: rgb(255 255 255 / .04); font-size: 25px; line-height: 1; cursor: pointer; transition: color .2s ease, background .2s ease; }
  .wl-close:hover { color: white; background: rgb(255 255 255 / .1); }
  .wl-celebration { position: relative; display: grid; width: 184px; height: 160px; place-items: center; margin: 0 auto 7px; }
  .wl-mascot-wrap { display: grid; width: 144px; height: 144px; place-items: center; border-radius: 50%; background: radial-gradient(circle, rgb(240 138 36 / .17), transparent 70%); animation: wl-mascot-pop 620ms cubic-bezier(.2,1.5,.45,1) both, wl-mascot-float 2.4s ease-in-out 620ms infinite; }
  .wl-mascot { display: block; width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 0 24px rgb(240 138 36 / .28)); }
  .wl-check { position: absolute; right: 11px; bottom: 4px; display: grid; width: 45px; height: 45px; place-items: center; border: 1px solid rgb(124 239 177 / .5); border-radius: 50%; background: #0e241c; box-shadow: 0 0 30px rgb(84 227 148 / .25); animation: wl-check-pop 420ms cubic-bezier(.2,1.4,.5,1) 280ms both; }
  .wl-check svg { width: 28px; height: 28px; }
  .wl-check path { stroke: #72e3a5; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 30; stroke-dashoffset: 30; animation: wl-check-draw 480ms ease 620ms forwards; }
  .wl-spark { position: absolute; color: #ffbd69; text-shadow: 0 0 14px rgb(255 176 78 / .8); animation: wl-sparkle 1.5s ease-in-out infinite alternate; }
  .wl-spark-one { top: 18px; left: 23px; font-size: 18px; }
  .wl-spark-two { top: 31px; right: 18px; font-size: 24px; animation-delay: .35s; }
  .wl-spark-three { bottom: 28px; left: 14px; font-size: 14px; animation-delay: .7s; }
  .wl-success-eyebrow { margin: 0 0 10px; color: #ffb253; font-size: 11px; font-weight: 800; letter-spacing: .19em; }
  .wl-success h2 { margin: 0; color: #faf9f6; font-size: clamp(27px, 5vw, 38px); font-weight: 750; letter-spacing: -.04em; }
  .wl-success-copy { max-width: 410px; margin: 11px auto 0; color: #aeb3be; font-size: 15px; line-height: 1.65; }
  .wl-success-follow { margin: 22px 0 10px; color: #888f9c; font-size: 12px; }
  .wl-success-links { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; }
  .wl-close-action { margin-top: 22px; padding: 9px 20px; border: 0; border-radius: 999px; color: #17100a; background: linear-gradient(110deg, #ffd082, #f08a24); font: inherit; font-size: 14px; font-weight: 700; cursor: pointer; transition: transform .2s ease, filter .2s ease; }
  .wl-close-action:hover { transform: translateY(-1px); filter: brightness(1.06); }
  .wl-close:focus-visible, .wl-close-action:focus-visible, .wl-success-links a:focus-visible, .wl-success-links button:focus-visible { outline: 2px solid #ffb253; outline-offset: 3px; }
  @keyframes wl-dialog-in { from { opacity: 0; transform: translateY(16px) scale(.97); } to { opacity: 1; transform: none; } }
  @keyframes wl-mascot-pop { from { opacity: 0; transform: translateY(12px) scale(.65) rotate(-8deg); } to { opacity: 1; transform: none; } }
  @keyframes wl-mascot-float { 50% { transform: translateY(-5px) rotate(2deg); } }
  @keyframes wl-check-pop { from { opacity: 0; transform: scale(.25) rotate(-22deg); } to { opacity: 1; transform: scale(1) rotate(0); } }
  @keyframes wl-check-draw { to { stroke-dashoffset: 0; } }
  @keyframes wl-sparkle { from { opacity: .35; transform: scale(.75) rotate(-12deg); } to { opacity: 1; transform: scale(1.12) rotate(12deg); } }
  @media (prefers-reduced-motion: reduce) { .wl-success[open], .wl-mascot-wrap, .wl-check, .wl-check path, .wl-spark { animation: none !important; } .wl-check path { stroke-dashoffset: 0; } }
  @media (max-width: 480px) { .wl-success-card { padding-top: 42px; } .wl-success-links { gap: 6px; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.waitlist').forEach((root) => {
    const form = root.querySelector('form')!;
    const note = root.querySelector<HTMLElement>('.wl-note')!;
    const success = root.querySelector<HTMLDialogElement>('.wl-success')!;
    const btn = form.querySelector('button')!;
    const closeButtons = root.querySelectorAll<HTMLButtonElement>('.wl-close, .wl-close-action');
    closeButtons.forEach((button) => button.addEventListener('click', () => success.close()));
    success.addEventListener('close', () => {
      form.classList.add('hidden'); note.classList.add('hidden');
      const heading = root.closest('section')?.querySelector<HTMLElement>('h2');
      if (heading) { heading.tabIndex = -1; heading.focus({ preventScroll: true }); }
    });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim().toLowerCase();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { note.textContent = 'Please enter a valid email address.'; note.style.color = '#fca5a5'; return; }
      const consent = form.elements.namedItem('release-consent') as HTMLInputElement;
      if (!consent.checked) { note.textContent = 'Please opt in to receive release updates.'; note.style.color = '#fca5a5'; return; }
      btn.disabled = true; btn.textContent = 'Joining…';
      try {
        const res = await fetch(`${root.dataset.url}/rest/v1/rpc/subscribe_release_email`, {
          method: 'POST',
          headers: { apikey: root.dataset.key!, Authorization: `Bearer ${root.dataset.key}`, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
          body: JSON.stringify({ email, p_plan_interest: root.dataset.plan || null, p_consent: true }),
        });
        if (!res.ok) throw new Error(String(res.status));
        if (typeof success.showModal === 'function') success.showModal();
        else success.setAttribute('open', '');
        root.querySelector<HTMLButtonElement>('.wl-close')?.focus();
      } catch {
        note.textContent = 'Something went wrong. Please try again, or join us on Discord.'; note.style.color = '#fca5a5';
        btn.disabled = false; btn.textContent = 'Try again';
      }
    });
    root.querySelector<HTMLButtonElement>('.wl-copy')?.addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      try { await navigator.clipboard.writeText(b.dataset.link!); b.textContent = 'Copied!'; } catch { b.textContent = b.dataset.link!; }
    });
  });
</script>
